---
interface Props {
  title: string;
  bodyHtml?: string;
}
const { title, bodyHtml } = Astro.props;
---

<!-- Layout 2 — Split Header / Wide Body -->
<article class="bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
  <header class="border-b border-black/10">
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-12 pt-20 pb-12">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12 items-end">
        <div class="lg:col-span-2">
          <span class="block h-[3px] w-10 bg-[rgb(200,90,70)]"></span>
        </div>
        <div class="lg:col-span-10">
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-light leading-[0.98] text-black tracking-tight">{title}</h1>
        </div>
      </div>
    </div>
  </header>

  {bodyHtml && (
    <section class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-12 pt-16 pb-24">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-2"></div>
        <div class="lg:col-span-10">
          <div class="dynamic-body" set:html={bodyHtml} />
        </div>
      </div>
    </section>
  )}
</article>
