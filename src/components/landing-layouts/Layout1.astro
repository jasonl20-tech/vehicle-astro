---
interface Props {
  title: string;
  bodyHtml?: string;
}
const { title, bodyHtml } = Astro.props;
---

<!-- Layout 1 — Editorial Wide -->
<article class="bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
  <header class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-12 pt-20 pb-12">
    <span class="block h-[3px] w-12 bg-[rgb(200,90,70)] mb-8"></span>
    <h1 class="text-5xl sm:text-6xl md:text-7xl font-light leading-[0.98] text-black tracking-tight">{title}</h1>
    <hr class="mt-12 border-black/10" />
  </header>

  {bodyHtml && (
    <section class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-12 pb-24">
      <div class="dynamic-body" set:html={bodyHtml} />
    </section>
  )}
</article>
