---
interface Props {
  title: string;
  bodyHtml?: string;
}
const { title, bodyHtml } = Astro.props;
---

<!-- Layout 5 — Minimal Premium Wide -->
<article class="bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">

  <section class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-12 pt-28 pb-12 text-center">
    <span class="mx-auto mb-10 block h-[2px] w-8 bg-[rgb(200,90,70)]"></span>
    <h1 class="mx-auto text-4xl sm:text-5xl md:text-6xl font-light leading-[1.05] text-black tracking-tight max-w-5xl">{title}</h1>
  </section>

  {bodyHtml && (
    <section class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-12 pb-32">
      <hr class="mb-16 border-black/10" />
      <div class="dynamic-body dynamic-body--lg" set:html={bodyHtml} />
    </section>
  )}
</article>
