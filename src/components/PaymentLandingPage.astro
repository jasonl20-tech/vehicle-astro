---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { loadPaymentLandingPage, type PaymentLandingField } from '../lib/cms-d1-content';
import { renderRichText } from '../lib/rich-text';

interface Props {
  slug: string;
  canonicalUrl: string;
}

const { slug, canonicalUrl } = Astro.props;
const { page, assets } = await loadPaymentLandingPage(slug, { locale: 'en-US' });

const htmlId = slug.replace(/[^a-z0-9]+/gi, '-');

const topHtml = page?.topText ? renderRichText(page.topText, assets) : '';
const bottomHtml = page?.bottomText ? renderRichText(page.bottomText, assets) : '';

const title = page?.metaTitle ?? 'Vehicle Imagery';
const description = page?.metaDescription ?? '';

const hasFormIntro =
  !!page?.requestAccessLabel?.trim() || !!page?.formTitle?.trim() || !!page?.formDescription?.trim();

function fieldRequired(f: PaymentLandingField): boolean {
  return f === 'email' || f === 'name';
}

---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Header />
  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    {!page ? (
      <section class="mx-auto max-w-2xl px-6 py-32 text-center sm:px-12">
        <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.2em] text-[rgb(200,90,70)]">Configuration</p>
        <h1 class="mb-4 text-3xl font-light tracking-tight text-black">Payment page not found</h1>
        <p class="text-[15px] leading-relaxed text-black/50">
          No <code class="rounded bg-black/5 px-1.5 py-0.5 text-sm">paymentSeiten</code> entry with title{' '}
          <span class="font-mono text-black/70">«{slug}»</span> for locale en-US. Add it in D1 to show this route.
        </p>
      </section>
    ) : (
      <>
        {/* Intro — centered */}
        <section class="mx-auto max-w-[1400px] px-6 pt-24 pb-12 sm:px-10 lg:px-16">
          <div class="mx-auto max-w-3xl text-center">
            {topHtml ? (
              <div class="payment-top-text dynamic-body" set:html={topHtml} />
            ) : null}
          </div>
        </section>

        {/* Full bottom rich text — full width band, prose centered */}
        <section class="w-full border-t border-black/[0.06] bg-[rgb(255,254,252)] py-14 sm:py-20 lg:py-24">
          <div class="mx-auto w-full max-w-4xl px-6 sm:px-10 lg:max-w-[56rem] lg:px-16">
            {bottomHtml ? (
              <div class="payment-bottom-rich dynamic-body" set:html={bottomHtml} />
            ) : (
              <p class="text-center text-[14px] text-black/40">No details configured (bottom text empty).</p>
            )}
          </div>
        </section>

        {/* Form — centered card with SVG field accents */}
        <section class="w-full px-6 py-16 sm:py-24 lg:px-8">
          <div class="mx-auto w-full max-w-xl">
            <div
              class="payment-form-card relative overflow-hidden rounded-[2rem] shadow-[0_32px_100px_-40px_rgba(10,43,49,0.45)]"
              style="background-color: rgb(10, 43, 49);"
            >
              <div
                class="pointer-events-none absolute inset-0 opacity-[0.04]"
                style="background-image: radial-gradient(rgba(255,255,255,0.85) 1px, transparent 1px); background-size: 20px 20px;"
                aria-hidden="true"
              />
              <div
                class="absolute left-1/2 top-0 h-[3px] w-24 -translate-x-1/2 rounded-b-full bg-[rgb(200,90,70)]"
                aria-hidden="true"
              />

              <div class="relative px-8 pb-12 pt-10 sm:px-12 sm:pb-14 sm:pt-12">
                {(page.requestAccessLabel || page.formTitle || page.formDescription) && (
                  <div class="mb-10 text-center">
                    {page.requestAccessLabel && (
                      <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.22em] text-white/35">{page.requestAccessLabel}</p>
                    )}
                    {page.formTitle && (
                      <h2 class="text-2xl font-light tracking-tight text-white sm:text-3xl">{page.formTitle}</h2>
                    )}
                    {page.formDescription && (
                      <p class="mx-auto mt-4 max-w-md text-[14px] leading-relaxed text-white/45">{page.formDescription}</p>
                    )}
                  </div>
                )}

                <div id={`payment-form-wrapper-${htmlId}`} class="payment-form-wrap transition-all duration-700 ease-out">
                  <div id={`payment-form-content-${htmlId}`}>
                    <form id={`payment-form-${htmlId}`} class:list={['space-y-5', !hasFormIntro && 'pt-2']}>
                      <input type="hidden" name="subject" value={page.formSubject} />

                      {page.formFields.map((field) => {
                        const label = page.labels[field] ?? field;
                        const shell =
                          'flex gap-4 rounded-xl border border-white/[0.12] bg-white/[0.04] px-4 py-3.5 backdrop-blur-sm transition-colors focus-within:border-[rgb(200,90,70)]/50 focus-within:bg-white/[0.07] sm:gap-5 sm:px-5';

                        if (field === 'message') {
                          return (
                            <div class:list={[shell, 'items-start']}>
                              <span class="mt-0.5 shrink-0 text-[rgb(200,90,70)]" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-5 w-5">
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                                  />
                                </svg>
                              </span>
                              <div class="min-w-0 flex-1">
                                <label class="mb-1.5 block text-left text-[10px] font-bold uppercase tracking-[0.12em] text-white/35" for={`${htmlId}-message`}>{label}</label>
                                <textarea
                                  id={`${htmlId}-message`}
                                  name="message"
                                  rows="4"
                                  placeholder={label}
                                  class="min-h-[5.5rem] w-full resize-y border-0 bg-transparent py-1 text-[14px] text-white caret-[rgb(200,90,70)] outline-none placeholder:text-white/28"
                                />
                              </div>
                            </div>
                          );
                        }

                        const nameAttr = field === 'company' ? 'company' : field;
                        const type = field === 'email' ? 'email' : 'text';
                        const auto = field === 'email' ? 'email' : field === 'name' ? 'name' : 'organization';

                        return (
                          <div class:list={[shell, 'items-center']}>
                            <span class:list={[iconClass]} aria-hidden="true">
                              {field === 'email' ? (
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-5 w-5">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                              ) : field === 'company' ? (
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-5 w-5">
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                  />
                                </svg>
                              ) : (
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-5 w-5">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                              )}
                            </span>
                            <div class="min-w-0 flex-1">
                              <label
                                class="mb-1.5 block text-left text-[10px] font-bold uppercase tracking-[0.12em] text-white/35"
                                for={`${htmlId}-${nameAttr}`}>{label}</label>
                              <input
                                id={`${htmlId}-${nameAttr}`}
                                type={type}
                                name={nameAttr}
                                required={fieldRequired(field)}
                                autocomplete={auto}
                                placeholder={label}
                                class="w-full border-0 bg-transparent py-0.5 text-[14px] text-white caret-[rgb(200,90,70)] outline-none placeholder:text-white/28"
                              />
                            </div>
                          </div>
                        );
                      })}

                      <div class="pt-2">
                        <button
                          type="submit"
                          class="group/btn mx-auto flex w-full max-w-xs items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-[13px] font-semibold tracking-wide text-[rgb(10,43,49)] shadow-lg transition-all duration-300 hover:bg-[rgb(200,90,70)] hover:text-white hover:shadow-md sm:max-w-none"
                        >
                          <svg class="h-5 w-5 shrink-0 text-[rgb(200,90,70)] opacity-80 group-hover/btn:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                          </svg>
                          <span>{page.submitButtonLabel}</span>
                          <svg
                            class="h-4 w-4 shrink-0 transition-transform group-hover/btn:translate-x-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                          </svg>
                        </button>
                      </div>
                    </form>
                  </div>

                  <div id={`payment-success-${htmlId}`} class="hidden flex-col items-center justify-center py-8 text-center">
                    <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-white/10 ring-2 ring-[rgb(200,90,70)]/30">
                      <svg class="h-8 w-8 text-emerald-400/95" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <h3 class="mb-2 text-xl font-light text-white">Request sent</h3>
                    <p class="max-w-xs text-[14px] leading-relaxed text-white/65">Thanks — we'll get back to you shortly.</p>
                  </div>
                </div>

                <style is:global>
                  .payment-top-text.dynamic-body {
                    margin-left: auto;
                    margin-right: auto;
                  }
                  .payment-top-text.dynamic-body h1,
                  .payment-top-text.dynamic-body h2,
                  .payment-top-text.dynamic-body h3 {
                    text-align: center;
                  }
                  .payment-top-text.dynamic-body h1 {
                    font-size: clamp(2.25rem, 5vw, 4rem);
                    font-weight: 300;
                    line-height: 1.05;
                    letter-spacing: -0.02em;
                    margin-bottom: 1.25rem;
                  }
                  .payment-top-text.dynamic-body p {
                    font-size: 1rem;
                    text-align: center;
                    margin-left: auto;
                    margin-right: auto;
                    max-width: 36rem;
                    color: rgba(0, 0, 0, 0.5);
                  }
                  /* Bottom: volle Breite Lesespalte, typische dynamic-body Styles */
                  .payment-bottom-rich.dynamic-body {
                    max-width: none;
                  }
                  .payment-bottom-rich.dynamic-body h2 {
                    text-align: center;
                    margin-top: 2rem;
                    margin-bottom: 1rem;
                  }
                  .payment-bottom-rich.dynamic-body h3 {
                    margin-top: 1.25rem;
                    margin-bottom: 0.5rem;
                  }
                  .payment-bottom-rich.dynamic-body > p:first-of-type {
                    max-width: 42rem;
                    margin-left: auto;
                    margin-right: auto;
                    text-align: center;
                  }
                  .payment-bottom-rich.dynamic-body ul,
                  .payment-bottom-rich.dynamic-body ol {
                    max-width: 40rem;
                    margin-left: auto;
                    margin-right: auto;
                  }
                  .payment-bottom-rich.dynamic-body table {
                    margin-left: auto;
                    margin-right: auto;
                  }
                </style>

                <script define:vars={{ htmlId }}>
                  (function () {
                    const form = document.getElementById('payment-form-' + htmlId);
                    const wrapper = document.getElementById('payment-form-wrapper-' + htmlId);
                    const formContent = document.getElementById('payment-form-content-' + htmlId);
                    const successEl = document.getElementById('payment-success-' + htmlId);
                    if (!form || !wrapper || !formContent || !successEl) return;
                    form.addEventListener('submit', (e) => {
                      e.preventDefault();
                      const data = Object.fromEntries(new FormData(form).entries());
                      fetch('/api/submit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                        body: JSON.stringify(data),
                      }).catch(() => {});
                      formContent.style.opacity = '0';
                      formContent.style.transform = 'scale(0.98)';
                      formContent.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                      setTimeout(() => {
                        formContent.classList.add('hidden');
                        wrapper.classList.add('success');
                        successEl.classList.remove('hidden');
                        successEl.classList.add('flex');
                        successEl.style.opacity = '0';
                        successEl.style.transform = 'scale(0.96)';
                        requestAnimationFrame(() => {
                          successEl.style.transition = 'opacity 0.45s ease 0.08s, transform 0.45s ease 0.08s';
                          successEl.style.opacity = '1';
                          successEl.style.transform = 'scale(1)';
                        });
                      }, 280);
                    });
                  })();
                </script>
              </div>
            </div>
          </div>
        </section>
      </>
    )}
  </main>
  <Footer />
</BaseLayout>

