---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { loadPaymentLandingPage, type PaymentLandingField } from '../lib/cms-d1-content';
import { renderRichText } from '../lib/rich-text';

interface Props {
  slug: string;
  canonicalUrl: string;
}

const { slug, canonicalUrl } = Astro.props;
const { page, assets } = await loadPaymentLandingPage(slug, { locale: 'en-US' });

const htmlId = slug.replace(/[^a-z0-9]+/gi, '-');

const topHtml = page?.topText ? renderRichText(page.topText, assets) : '';
const bottomHtml = page?.bottomText ? renderRichText(page.bottomText, assets) : '';

const title = page?.metaTitle ?? 'Vehicle Imagery';
const description = page?.metaDescription ?? '';

function fieldRequired(f: PaymentLandingField): boolean {
  return f === 'email' || f === 'name';
}

/** Gleiches Dunkel wie Header-Leiste („Vehicle“-Chrom) für einheitliche Flächen */
const panelDark = '#1C2B32';

const underlineInput =
  `w-full border-0 border-b border-b-white/15 bg-transparent px-0 py-3 text-[13px] text-white caret-[rgb(200,90,70)] placeholder:text-white/40 shadow-none transition-colors focus:border-0 focus:border-b focus:border-[rgb(200,90,70)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(200,90,70)]/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1C2B32]`;

const underlineTextarea =
  `min-h-[4.5rem] w-full resize-y border-0 border-b border-b-white/15 bg-transparent px-0 py-3 text-[13px] text-white caret-[rgb(200,90,70)] placeholder:text-white/40 shadow-none transition-colors focus:border-b focus:border-[rgb(200,90,70)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(200,90,70)]/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1C2B32]`;

const shellPad = 'mx-auto w-full max-w-[min(100%,1680px)] px-3 sm:px-4 md:px-5 lg:px-6';
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Header />
  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    {!page ? (
      <section class="mx-auto max-w-2xl px-6 py-32 text-center sm:px-12">
        <p class="mb-4 text-[10px] font-bold uppercase tracking-[0.2em] text-[rgb(200,90,70)]">Configuration</p>
        <h1 class="mb-4 text-3xl font-light tracking-tight text-black">Payment page not found</h1>
        <p class="text-[15px] leading-relaxed text-black/50">
          No <code class="rounded bg-black/5 px-1.5 py-0.5 text-sm">paymentSeiten</code> entry with title{' '}
          <span class="font-mono text-black/70">«{slug}»</span> for locale en-US. Add it in D1 to show this route.
        </p>
      </section>
    ) : (
      <>
        <!-- 1) Top text — gleiche seitliche Ausnutzung wie unten -->
        <section class="w-full pt-24 pb-10">
          <div class:list={[shellPad, 'text-center']}>
            {topHtml ? <div class="payment-top-text dynamic-body" set:html={topHtml} /> : null}
          </div>
        </section>

        <!-- 2) Form — Farben wie Header/Navigation (#1C2B32), Terracotta-Akzente -->
        <section class="w-full pb-16">
          <div class={shellPad}>
            <div class="mx-auto w-full max-w-xl">
            <div
              class={`payment-form-panel group relative overflow-hidden rounded-[2rem] text-white transition-all duration-500 hover:shadow-[0_40px_80px_-20px_rgba(28,43,50,0.45)]`}
              style={`background-color: ${panelDark}; color-scheme: dark;`}
            >
              <div
                class="pointer-events-none absolute inset-0 opacity-[0.03]"
                style="background-image: radial-gradient(rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 28px 28px;"
                aria-hidden="true"
              />
              <div
                class="absolute left-0 top-0 h-[2px] w-full bg-gradient-to-r from-[rgb(200,90,70)] via-[rgb(200,90,70)]/50 to-transparent"
                aria-hidden="true"
              />

              <div class="relative p-10 sm:p-14">
                {(page.requestAccessLabel || page.formTitle || page.formDescription) && (
                  <div class="mb-10 text-center">
                    {page.requestAccessLabel && (
                      <span class="mb-4 block text-[10px] font-bold uppercase tracking-[0.2em] text-white/40">{page.requestAccessLabel}</span>
                    )}
                    {page.formTitle && (
                      <h2 class="text-3xl font-light tracking-tight text-white sm:text-4xl">{page.formTitle}</h2>
                    )}
                    {page.formDescription && (
                      <p class="mx-auto mt-4 max-w-sm text-[14px] leading-relaxed text-white/55">{page.formDescription}</p>
                    )}
                  </div>
                )}

                <div id={`payment-form-wrapper-${htmlId}`} class="payment-form-wrap transition-all duration-700 ease-out">
                  <div id={`payment-form-content-${htmlId}`}>
                    <form id={`payment-form-${htmlId}`} class="space-y-5">
                      <input type="hidden" name="subject" value={page.formSubject} />

                      {page.formFields.map((field) => {
                        const label = page.labels[field] ?? field;

                        if (field === 'message') {
                          return (
                            <div>
                              <label class="sr-only" for={`${htmlId}-message`}>{label}</label>
                              <textarea
                                id={`${htmlId}-message`}
                                name="message"
                                rows="3"
                                placeholder={label}
                                class={underlineTextarea}
                              />
                            </div>
                          );
                        }

                        const nameAttr = field === 'company' ? 'company' : field;
                        const type = field === 'email' ? 'email' : 'text';
                        const auto = field === 'email' ? 'email' : field === 'name' ? 'name' : 'organization';

                        return (
                          <div>
                            <label class="sr-only" for={`${htmlId}-${nameAttr}`}>{label}</label>
                            <input
                              id={`${htmlId}-${nameAttr}`}
                              type={type}
                              name={nameAttr}
                              required={fieldRequired(field)}
                              autocomplete={auto}
                              placeholder={label}
                              class={underlineInput}
                            />
                          </div>
                        );
                      })}

                      <div class="pt-4">
                        <button
                          type="submit"
                          class="group/btn inline-flex w-full items-center justify-center rounded-full bg-white px-8 py-4 text-[13px] font-medium text-[#1C2B32] shadow-sm transition-all duration-300 hover:bg-[rgb(200,90,70)] hover:text-white hover:shadow-md sm:w-auto"
                        >
                          <span>{page.submitButtonLabel}</span>
                          <svg
                            class="ml-2 h-4 w-4 transform transition-transform group-hover/btn:translate-x-1"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                          </svg>
                        </button>
                      </div>
                    </form>
                  </div>

                  <div id={`payment-success-${htmlId}`} class="hidden flex-col items-center justify-center py-12 text-center">
                    <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white/20">
                      <svg class="h-10 w-10" viewBox="0 0 52 52" fill="none">
                        <circle
                          cx="26"
                          cy="26"
                          r="24"
                          stroke="white"
                          stroke-width="2.5"
                          fill="none"
                          stroke-dasharray="150.8"
                          stroke-dashoffset="150.8"
                          class="pay-suc-circle"
                        />
                        <path
                          d="M15 27L23 35L37 19"
                          stroke="white"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          fill="none"
                          stroke-dasharray="40"
                          stroke-dashoffset="40"
                          class="pay-suc-check"
                        />
                      </svg>
                    </div>
                    <h3 class="mb-3 text-2xl font-normal text-white">Request sent</h3>
                    <p class="max-w-xs text-[14px] leading-relaxed text-white/70">Thanks — we'll get back to you shortly.</p>
                  </div>
                </div>

                <style is:global>
                  /* Erzwingt Lesbarkeit gegen Browser-/Theme-Defaults + Autofill */
                  .payment-form-panel input:not([type='hidden']),
                  .payment-form-panel textarea {
                    color: rgb(255, 255, 255) !important;
                    -webkit-text-fill-color: rgb(255, 255, 255) !important;
                  }
                  .payment-form-panel input::placeholder,
                  .payment-form-panel textarea::placeholder {
                    color: rgba(255, 255, 255, 0.42) !important;
                    opacity: 1 !important;
                  }
                  .payment-form-panel input:-webkit-autofill,
                  .payment-form-panel input:-webkit-autofill:hover,
                  .payment-form-panel input:-webkit-autofill:focus,
                  .payment-form-panel textarea:-webkit-autofill,
                  .payment-form-panel textarea:-webkit-autofill:hover,
                  .payment-form-panel textarea:-webkit-autofill:focus {
                    -webkit-box-shadow: 0 0 0 1000px #1c2b32 inset !important;
                    box-shadow: 0 0 0 1000px #1c2b32 inset !important;
                    -webkit-text-fill-color: rgb(255, 255, 255) !important;
                    caret-color: rgb(200, 90, 70) !important;
                    transition: background-color 9999s ease-out 0s;
                  }
                  .payment-form-panel ::selection {
                    background: rgba(200, 90, 70, 0.35);
                    color: #fff;
                  }
                </style>

                <style>
                  @keyframes pay-draw-circle {
                    to {
                      stroke-dashoffset: 0;
                    }
                  }
                  @keyframes pay-draw-check {
                    to {
                      stroke-dashoffset: 0;
                    }
                  }
                  .payment-form-wrap.success .pay-suc-circle {
                    animation: pay-draw-circle 0.6s ease-out 0.2s forwards;
                  }
                  .payment-form-wrap.success .pay-suc-check {
                    animation: pay-draw-check 0.4s ease-out 0.7s forwards;
                  }
                </style>

                <script define:vars={{ htmlId }}>
                  (function () {
                    const form = document.getElementById('payment-form-' + htmlId);
                    const wrapper = document.getElementById('payment-form-wrapper-' + htmlId);
                    const formContent = document.getElementById('payment-form-content-' + htmlId);
                    const successEl = document.getElementById('payment-success-' + htmlId);
                    if (!form || !wrapper || !formContent || !successEl) return;
                    form.addEventListener('submit', (e) => {
                      e.preventDefault();
                      const data = Object.fromEntries(new FormData(form).entries());
                      fetch('/api/submit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                        body: JSON.stringify(data),
                      }).catch(() => {});
                      formContent.style.opacity = '0';
                      formContent.style.transform = 'scale(0.95)';
                      formContent.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                      setTimeout(() => {
                        formContent.classList.add('hidden');
                        wrapper.classList.add('success');
                        successEl.classList.remove('hidden');
                        successEl.classList.add('flex');
                        successEl.style.opacity = '0';
                        successEl.style.transform = 'scale(0.95)';
                        requestAnimationFrame(() => {
                          successEl.style.transition = 'opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s';
                          successEl.style.opacity = '1';
                          successEl.style.transform = 'scale(1)';
                        });
                      }, 300);
                    });
                  })();
                </script>
              </div>
            </div>
            </div>
          </div>
        </section>

        <!-- 3) Bottom rich text — sehr breit, wenig Rand (gleicher shell wie Top) -->
        <section class="w-full border-t border-black/[0.06] bg-[rgb(255,254,252)] py-14 sm:py-20 lg:py-24">
          <div class={shellPad}>
            {bottomHtml ? (
              <div class="payment-bottom-rich dynamic-body" set:html={bottomHtml} />
            ) : (
              <p class="text-center text-[14px] text-black/40">No details configured (bottom text empty).</p>
            )}
          </div>
        </section>

        <style is:global>
          .payment-top-text.dynamic-body {
            margin-left: auto;
            margin-right: auto;
          }
          .payment-top-text.dynamic-body h1,
          .payment-top-text.dynamic-body h2,
          .payment-top-text.dynamic-body h3 {
            text-align: center;
          }
          .payment-top-text.dynamic-body h1 {
            font-size: clamp(2.25rem, 5vw, 4rem);
            font-weight: 300;
            line-height: 1.05;
            letter-spacing: -0.02em;
            margin-bottom: 1.25rem;
          }
          .payment-top-text.dynamic-body p {
            font-size: 1rem;
            text-align: center;
            margin-left: auto;
            margin-right: auto;
            max-width: none;
            color: rgba(0, 0, 0, 0.5);
          }

          .payment-bottom-rich.dynamic-body {
            max-width: none;
          }
          .payment-bottom-rich.dynamic-body h2 {
            text-align: center;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
          }
          .payment-bottom-rich.dynamic-body h3 {
            margin-top: 1.25rem;
            margin-bottom: 0.5rem;
          }
          .payment-bottom-rich.dynamic-body ul,
          .payment-bottom-rich.dynamic-body ol {
            max-width: none;
            margin-left: 0;
            margin-right: 0;
          }
          .payment-bottom-rich.dynamic-body table {
            width: 100%;
            max-width: none;
            margin-left: 0;
            margin-right: 0;
          }
          .payment-bottom-rich.dynamic-body figure {
            margin-left: auto;
            margin-right: auto;
          }
        </style>
      </>
    )}
  </main>
  <Footer />
</BaseLayout>
