---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { ContactPageForm } from '../lib/cms-d1-content';

interface Props {
  metaTitle: string;
  metaDescription: string;
  canonicalUrl: string;
  topHtml: string;
  bottomHtml: string;
  /** Nur /contact: Labels aus D1 `forms` */
  form?: ContactPageForm;
  /** Nur Book-a-Call: Kalender-Embed aus firmenKonfiguration */
  meetingEmbed?: string;
}

const { metaTitle, metaDescription, canonicalUrl, topHtml, bottomHtml, form, meetingEmbed } = Astro.props;
const hasTop = topHtml.trim().length > 0;
const hasBottom = bottomHtml.trim().length > 0;
const hasEmbed = Boolean(meetingEmbed?.trim());
const hasForm = Boolean(form);
---

<BaseLayout title={metaTitle} description={metaDescription} canonicalUrl={canonicalUrl}>
  <Header />
  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    {hasTop && (
      <section class="mx-auto max-w-[900px] px-6 pt-16 pb-8 sm:px-12 lg:px-16">
        <div class="dynamic-body dynamic-body--docs" set:html={topHtml} />
      </section>
    )}
    {hasForm && form && (
      <section class="w-full bg-[#F5F5F7] py-24 md:py-32">
        <div class="w-full px-4 sm:px-6 md:px-8">
          <div class="mx-auto max-w-[1200px]">
            <div class="flex flex-col overflow-hidden rounded-[2px] bg-white shadow-2xl lg:flex-row">
              <div
                class="relative overflow-hidden p-10 text-white sm:p-12 lg:w-[40%] lg:p-16"
                style="background-color: rgb(10, 43, 49);"
              >
                <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-white/5 blur-3xl"></div>
                <div class="pointer-events-none absolute -bottom-20 -left-20 h-80 w-80 rounded-full bg-[rgb(200,90,70)]/20 blur-3xl"></div>
                <div class="relative z-10 flex h-full min-h-[120px] flex-col justify-center lg:justify-between">
                  <div>
                    <h2 class="mb-0 text-3xl font-black tracking-tighter text-white sm:text-4xl">
                      {form.heading || 'Contact'}
                    </h2>
                  </div>
                </div>
              </div>
              <div
                id="cms-contact-wrapper"
                class="transition-all duration-700 ease-out p-10 sm:p-12 lg:w-[60%] lg:p-16"
              >
                <div id="cms-contact-form-wrap">
                  <form id="cms-contact-form" class="space-y-6">
                    <input type="hidden" name="subject" value={form.subject} />
                    {form.showName && (
                      <div>
                        <label for="cms-contact-name" class="mb-2 block text-xs font-bold uppercase tracking-widest text-gray-600">{form.nameLabel}</label>
                        <input
                          id="cms-contact-name"
                          type="text"
                          name="name"
                          required
                          autocomplete="name"
                          class="w-full rounded-[2px] border border-gray-200 bg-gray-50 px-4 py-3 text-black transition-all focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                        />
                      </div>
                    )}
                    {form.showEmail && (
                      <div>
                        <label for="cms-contact-email" class="mb-2 block text-xs font-bold uppercase tracking-widest text-gray-600">{form.emailLabel}</label>
                        <input
                          id="cms-contact-email"
                          type="email"
                          name="email"
                          required
                          autocomplete="email"
                          class="w-full rounded-[2px] border border-gray-200 bg-gray-50 px-4 py-3 text-black transition-all focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                        />
                      </div>
                    )}
                    {form.showCompany && (
                      <div>
                        <label for="cms-contact-company" class="mb-2 block text-xs font-bold uppercase tracking-widest text-gray-600">{form.companyLabel}</label>
                        <input
                          id="cms-contact-company"
                          type="text"
                          name="company"
                          autocomplete="organization"
                          class="w-full rounded-[2px] border border-gray-200 bg-gray-50 px-4 py-3 text-black transition-all focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                        />
                      </div>
                    )}
                    {form.showMessage && (
                      <div>
                        <label for="cms-contact-message" class="mb-2 block text-xs font-bold uppercase tracking-widest text-gray-600">{form.messageLabel}</label>
                        <textarea
                          id="cms-contact-message"
                          name="message"
                          rows={4}
                          required
                          class="w-full resize-none rounded-[2px] border border-gray-200 bg-gray-50 px-4 py-3 text-black transition-all focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                        />
                      </div>
                    )}
                    <div class="pt-2">
                      <button
                        type="submit"
                        id="cms-contact-btn"
                        class="w-full transform rounded-[2px] bg-black px-8 py-4 text-sm font-bold uppercase tracking-widest text-white shadow-lg transition-colors duration-200 hover:-translate-y-0.5 hover:bg-[rgb(200,90,70)] hover:shadow-xl"
                      >
                        {form.submitLabel}
                      </button>
                    </div>
                  </form>
                </div>
                <div id="cms-contact-success" class="hidden flex-col items-center justify-center py-16 text-center">
                  <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-emerald-100">
                    <svg class="h-10 w-10 text-emerald-600" viewBox="0 0 52 52" fill="none" aria-hidden="true">
                      <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-dasharray="150.8" stroke-dashoffset="150.8" class="cms-contact-circle" />
                      <path d="M15 27L23 35L37 19" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke-dasharray="40" stroke-dashoffset="40" class="cms-contact-check" />
                    </svg>
                  </div>
                  <p class="text-lg font-medium text-black">Thank you</p>
                  <p class="mt-2 max-w-sm text-[15px] text-black/50">We have received your message.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <style>
          @keyframes cms-contact-dc { to { stroke-dashoffset: 0; } }
          @keyframes cms-contact-dk { to { stroke-dashoffset: 0; } }
          #cms-contact-wrapper.success .cms-contact-circle { animation: cms-contact-dc 0.6s ease-out 0.2s forwards; }
          #cms-contact-wrapper.success .cms-contact-check { animation: cms-contact-dk 0.4s ease-out 0.7s forwards; }
        </style>
        <script>
          (function () {
            const form = document.getElementById('cms-contact-form') as HTMLFormElement | null;
            const wrapper = document.getElementById('cms-contact-wrapper');
            const formWrap = document.getElementById('cms-contact-form-wrap');
            const success = document.getElementById('cms-contact-success');
            if (!form || !wrapper || !formWrap || !success) return;
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              const data = Object.fromEntries(new FormData(form).entries());
              fetch('/api/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify(data),
              }).catch(() => {});
              formWrap.style.opacity = '0';
              formWrap.style.transform = 'scale(0.95)';
              formWrap.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
              setTimeout(() => {
                formWrap.classList.add('hidden');
                wrapper.classList.add('success');
                wrapper.style.backgroundColor = '#f0fdf4';
                success.classList.remove('hidden');
                success.classList.add('flex');
                success.style.opacity = '0';
                success.style.transform = 'scale(0.95)';
                requestAnimationFrame(() => {
                  success.style.transition = 'opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s';
                  success.style.opacity = '1';
                  success.style.transform = 'scale(1)';
                });
              }, 300);
            });
          })();
        </script>
      </section>
    )}
    {hasEmbed && (
      <section class="mx-auto max-w-[1400px] px-6 pb-8 sm:px-12 lg:px-16 min-w-0">
        <Fragment set:html={meetingEmbed!} />
      </section>
    )}
    {hasBottom && (
      <section class="mx-auto max-w-[900px] px-6 pb-24 sm:px-12 lg:px-16">
        <div class="dynamic-body dynamic-body--docs" set:html={bottomHtml} />
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
