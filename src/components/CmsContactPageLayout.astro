---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { ContactPageForm } from '../lib/cms-d1-content';

interface Props {
  metaTitle: string;
  metaDescription: string;
  canonicalUrl: string;
  topHtml: string;
  bottomHtml: string;
  /** Nur /contact: Labels aus D1 `forms` */
  form?: ContactPageForm;
  /** Nur Book-a-Call: Kalender-Embed aus firmenKonfiguration */
  meetingEmbed?: string;
}

const { metaTitle, metaDescription, canonicalUrl, topHtml, bottomHtml, form, meetingEmbed } = Astro.props;
const hasTop = topHtml.trim().length > 0;
const hasBottom = bottomHtml.trim().length > 0;
const hasEmbed = Boolean(meetingEmbed?.trim());
const hasForm = Boolean(form);
---

<BaseLayout title={metaTitle} description={metaDescription} canonicalUrl={canonicalUrl}>
  <Header />
  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    {hasTop && (
      <section class="mx-auto max-w-[900px] px-6 pt-16 pb-8 sm:px-12 lg:px-16">
        <div class="dynamic-body dynamic-body--docs" set:html={topHtml} />
      </section>
    )}
    {hasForm && form && (
      <section class="mx-auto max-w-[900px] px-6 pb-10 sm:px-12 lg:px-16">
        <div id="cms-contact-wrapper" class="overflow-hidden rounded-2xl border border-black/[0.08] bg-[#f5f5f7] shadow-[0_20px_60px_-28px_rgba(10,43,49,0.15)]">
          <div id="cms-contact-inner" class="p-8 sm:p-10">
            <div id="cms-contact-form-wrap">
              {form.heading && (
                <h2 class="mb-6 text-xl font-bold tracking-tight text-black sm:text-2xl">{form.heading}</h2>
              )}
              <form id="cms-contact-form" class="space-y-5">
                <input type="hidden" name="subject" value={form.subject} />
                {form.showName && (
                  <div>
                    <label for="cms-contact-name" class="mb-2 block text-xs font-bold uppercase tracking-widest text-black/55">{form.nameLabel}</label>
                    <input
                      id="cms-contact-name"
                      type="text"
                      name="name"
                      required
                      autocomplete="name"
                      class="w-full rounded-md border border-black/10 bg-white px-4 py-3 text-black placeholder:text-black/30 focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                    />
                  </div>
                )}
                {form.showEmail && (
                  <div>
                    <label for="cms-contact-email" class="mb-2 block text-xs font-bold uppercase tracking-widest text-black/55">{form.emailLabel}</label>
                    <input
                      id="cms-contact-email"
                      type="email"
                      name="email"
                      required
                      autocomplete="email"
                      class="w-full rounded-md border border-black/10 bg-white px-4 py-3 text-black placeholder:text-black/30 focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                    />
                  </div>
                )}
                {form.showCompany && (
                  <div>
                    <label for="cms-contact-company" class="mb-2 block text-xs font-bold uppercase tracking-widest text-black/55">{form.companyLabel}</label>
                    <input
                      id="cms-contact-company"
                      type="text"
                      name="company"
                      autocomplete="organization"
                      class="w-full rounded-md border border-black/10 bg-white px-4 py-3 text-black placeholder:text-black/30 focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                    />
                  </div>
                )}
                {form.showMessage && (
                  <div>
                    <label for="cms-contact-message" class="mb-2 block text-xs font-bold uppercase tracking-widest text-black/55">{form.messageLabel}</label>
                    <textarea
                      id="cms-contact-message"
                      name="message"
                      rows={5}
                      required
                      class="w-full resize-y rounded-md border border-black/10 bg-white px-4 py-3 text-black placeholder:text-black/30 focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                    />
                  </div>
                )}
                <button
                  type="submit"
                  id="cms-contact-btn"
                  class="w-full rounded-md bg-[rgb(10,43,49)] px-6 py-3.5 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:bg-[rgb(200,90,70)]"
                >
                  {form.submitLabel}
                </button>
              </form>
            </div>
            <div id="cms-contact-success" class="hidden flex-col items-center justify-center py-12 text-center">
              <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100">
                <svg class="h-8 w-8 text-emerald-600" viewBox="0 0 52 52" fill="none" aria-hidden="true">
                  <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-dasharray="150.8" stroke-dashoffset="150.8" class="cms-contact-circle" />
                  <path d="M15 27L23 35L37 19" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke-dasharray="40" stroke-dashoffset="40" class="cms-contact-check" />
                </svg>
              </div>
              <p class="text-lg font-medium text-black">Thank you</p>
              <p class="mt-2 max-w-sm text-[15px] text-black/50">We have received your message.</p>
            </div>
          </div>
        </div>
        <style>
          @keyframes cms-contact-dc { to { stroke-dashoffset: 0; } }
          @keyframes cms-contact-dk { to { stroke-dashoffset: 0; } }
          #cms-contact-wrapper.success .cms-contact-circle { animation: cms-contact-dc 0.6s ease-out 0.2s forwards; }
          #cms-contact-wrapper.success .cms-contact-check { animation: cms-contact-dk 0.4s ease-out 0.7s forwards; }
        </style>
        <script>
          (function () {
            const form = document.getElementById('cms-contact-form') as HTMLFormElement | null;
            const wrapper = document.getElementById('cms-contact-wrapper');
            const formWrap = document.getElementById('cms-contact-form-wrap');
            const success = document.getElementById('cms-contact-success');
            form?.addEventListener('submit', (e) => {
              e.preventDefault();
              const data = Object.fromEntries(new FormData(form).entries());
              fetch('/api/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify(data),
              }).catch(() => {});
              if (formWrap) {
                formWrap.style.opacity = '0';
                formWrap.style.transition = 'opacity 0.25s ease';
              }
              setTimeout(() => {
                formWrap?.classList.add('hidden');
                wrapper?.classList.add('success');
                success?.classList.remove('hidden');
                success?.classList.add('flex');
              }, 280);
            });
          })();
        </script>
      </section>
    )}
    {hasEmbed && (
      <section class="mx-auto max-w-[1400px] px-6 pb-8 sm:px-12 lg:px-16 min-w-0">
        <Fragment set:html={meetingEmbed!} />
      </section>
    )}
    {hasBottom && (
      <section class="mx-auto max-w-[900px] px-6 pb-24 sm:px-12 lg:px-16">
        <div class="dynamic-body dynamic-body--docs" set:html={bottomHtml} />
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
