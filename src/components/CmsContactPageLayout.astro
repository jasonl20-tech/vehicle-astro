---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { ContactPageForm } from '../lib/cms-d1-content';

interface Props {
  metaTitle: string;
  metaDescription: string;
  canonicalUrl: string;
  topHtml: string;
  bottomHtml: string;
  /** Nur /contact: Labels aus D1 `forms` */
  form?: ContactPageForm;
  /** Nur Book-a-Call: Kalender-Embed aus firmenKonfiguration */
  meetingEmbed?: string;
}

const { metaTitle, metaDescription, canonicalUrl, topHtml, bottomHtml, form, meetingEmbed } = Astro.props;
const hasTop = topHtml.trim().length > 0;
const hasBottom = bottomHtml.trim().length > 0;
const hasEmbed = Boolean(meetingEmbed?.trim());
const hasForm = Boolean(form);

/** Gleiches Panel wie PaymentLandingPage /trial (Dunkel #1C2B32, Underline-Felder). */
const panelDark = '#1C2B32';
const underlineEmailInput =
  `payment-field-email w-full border-0 border-b border-b-white/15 bg-transparent px-0 py-3 text-[13px] text-white caret-[rgb(200,90,70)] placeholder:text-white/[0.26] shadow-none transition-colors focus:border-0 focus:border-b focus:border-[rgb(200,90,70)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(200,90,70)]/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1C2B32]`;
const underlineInput =
  `w-full border-0 border-b border-b-white/15 bg-transparent px-0 py-3 text-[13px] text-white caret-[rgb(200,90,70)] placeholder:text-white/40 shadow-none transition-colors focus:border-0 focus:border-b focus:border-[rgb(200,90,70)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(200,90,70)]/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1C2B32]`;
const underlineTextarea =
  `min-h-[4.5rem] w-full resize-y border-0 border-b border-b-white/15 bg-transparent px-0 py-3 text-[13px] text-white caret-[rgb(200,90,70)] placeholder:text-white/40 shadow-none transition-colors focus:border-b focus:border-[rgb(200,90,70)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(200,90,70)]/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1C2B32]`;
---

<BaseLayout title={metaTitle} description={metaDescription} canonicalUrl={canonicalUrl}>
  <Header />
  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    {hasTop && (
      <section class="mx-auto max-w-[900px] px-6 pt-16 pb-8 sm:px-12 lg:px-16">
        <div class="dynamic-body dynamic-body--docs" set:html={topHtml} />
      </section>
    )}
    {hasForm && form && (
      <section class="mx-auto max-w-[900px] px-6 pb-16 pt-4 sm:px-12 lg:px-16">
        <div class="w-full">
            <div
              class="cms-contact-form-panel group relative w-full overflow-hidden rounded-[2rem] text-white transition-all duration-500 hover:shadow-[0_40px_80px_-20px_rgba(28,43,50,0.45)]"
              style={`background-color: ${panelDark}; color-scheme: dark;`}
            >
              <div
                class="pointer-events-none absolute inset-0 opacity-[0.03]"
                style="background-image: radial-gradient(rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 28px 28px;"
                aria-hidden="true"
              />
              <div
                class="absolute left-0 top-0 h-[2px] w-full bg-gradient-to-r from-[rgb(200,90,70)] via-[rgb(200,90,70)]/50 to-transparent"
                aria-hidden="true"
              />

              <div class="relative p-10 sm:p-14">
                <div class="mb-10 text-center">
                  <h2 class="text-3xl font-light tracking-tight text-white sm:text-4xl">{form.heading || 'Contact'}</h2>
                </div>

                <div id="cms-contact-form-wrapper" class="cms-contact-form-wrap transition-all duration-700 ease-out">
                  <div id="cms-contact-form-content">
                    <form id="cms-contact-form" class="space-y-5">
                      <input type="hidden" name="subject" value={form.subject} />
                      {form.showName && (
                        <div>
                          <label class="sr-only" for="cms-contact-name">{form.nameLabel}</label>
                          <input
                            id="cms-contact-name"
                            type="text"
                            name="name"
                            required
                            autocomplete="name"
                            placeholder={form.nameLabel}
                            class={underlineInput}
                          />
                        </div>
                      )}
                      {form.showEmail && (
                        <div>
                          <label class="sr-only" for="cms-contact-email">{form.emailLabel}</label>
                          <input
                            id="cms-contact-email"
                            type="email"
                            name="email"
                            required
                            autocomplete="email"
                            placeholder={form.emailLabel}
                            class={underlineEmailInput}
                          />
                        </div>
                      )}
                      {form.showCompany && (
                        <div>
                          <label class="sr-only" for="cms-contact-company">{form.companyLabel}</label>
                          <input
                            id="cms-contact-company"
                            type="text"
                            name="company"
                            autocomplete="organization"
                            placeholder={form.companyLabel}
                            class={underlineInput}
                          />
                        </div>
                      )}
                      {form.showMessage && (
                        <div>
                          <label class="sr-only" for="cms-contact-message">{form.messageLabel}</label>
                          <textarea
                            id="cms-contact-message"
                            name="message"
                            rows={3}
                            required
                            placeholder={form.messageLabel}
                            class={underlineTextarea}
                          />
                        </div>
                      )}
                      <div class="pt-4">
                        <button
                          type="submit"
                          id="cms-contact-btn"
                          class="group/btn inline-flex w-full items-center justify-center rounded-full bg-white px-8 py-4 text-[13px] font-medium text-[#1C2B32] shadow-sm transition-all duration-300 hover:bg-[rgb(200,90,70)] hover:text-white hover:shadow-md sm:w-auto"
                        >
                          <span>{form.submitLabel}</span>
                          <svg
                            class="ml-2 h-4 w-4 transform transition-transform group-hover/btn:translate-x-1"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                          </svg>
                        </button>
                      </div>
                    </form>
                  </div>

                  <div id="cms-contact-success" class="hidden flex-col items-center justify-center py-12 text-center">
                    <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white/20">
                      <svg class="h-10 w-10" viewBox="0 0 52 52" fill="none" aria-hidden="true">
                        <circle
                          cx="26"
                          cy="26"
                          r="24"
                          stroke="white"
                          stroke-width="2.5"
                          fill="none"
                          stroke-dasharray="150.8"
                          stroke-dashoffset="150.8"
                          class="ccf-suc-circle"
                        />
                        <path
                          d="M15 27L23 35L37 19"
                          stroke="white"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          fill="none"
                          stroke-dasharray="40"
                          stroke-dashoffset="40"
                          class="ccf-suc-check"
                        />
                      </svg>
                    </div>
                    <h3 class="mb-3 text-2xl font-normal text-white">Request sent</h3>
                    <p class="max-w-xs text-[14px] leading-relaxed text-white/70">Thanks — we'll get back to you shortly.</p>
                  </div>
                </div>

                <style is:global>
                  .cms-contact-form-panel input:not([type='hidden']),
                  .cms-contact-form-panel textarea {
                    color: rgb(255, 255, 255) !important;
                    -webkit-text-fill-color: rgb(255, 255, 255) !important;
                  }
                  .cms-contact-form-panel input:not(.payment-field-email)::placeholder,
                  .cms-contact-form-panel textarea::placeholder {
                    color: rgba(255, 255, 255, 0.42) !important;
                    opacity: 1 !important;
                  }
                  .cms-contact-form-panel input.payment-field-email::placeholder {
                    color: rgba(255, 255, 255, 0.26) !important;
                    opacity: 1 !important;
                  }
                  .cms-contact-form-panel input:-webkit-autofill,
                  .cms-contact-form-panel input:-webkit-autofill:hover,
                  .cms-contact-form-panel input:-webkit-autofill:focus,
                  .cms-contact-form-panel textarea:-webkit-autofill,
                  .cms-contact-form-panel textarea:-webkit-autofill:hover,
                  .cms-contact-form-panel textarea:-webkit-autofill:focus {
                    -webkit-box-shadow: 0 0 0 1000px #1c2b32 inset !important;
                    box-shadow: 0 0 0 1000px #1c2b32 inset !important;
                    -webkit-text-fill-color: rgb(255, 255, 255) !important;
                    caret-color: rgb(200, 90, 70) !important;
                    transition: background-color 9999s ease-out 0s;
                  }
                  .cms-contact-form-panel ::selection {
                    background: rgba(200, 90, 70, 0.35);
                    color: #fff;
                  }
                </style>

                <style>
                  @keyframes ccf-draw-circle {
                    to {
                      stroke-dashoffset: 0;
                    }
                  }
                  @keyframes ccf-draw-check {
                    to {
                      stroke-dashoffset: 0;
                    }
                  }
                  .cms-contact-form-wrap.success .ccf-suc-circle {
                    animation: ccf-draw-circle 0.6s ease-out 0.2s forwards;
                  }
                  .cms-contact-form-wrap.success .ccf-suc-check {
                    animation: ccf-draw-check 0.4s ease-out 0.7s forwards;
                  }
                </style>

                <script>
                  (function () {
                    const form = document.getElementById('cms-contact-form') as HTMLFormElement | null;
                    const wrapper = document.getElementById('cms-contact-form-wrapper');
                    const formContent = document.getElementById('cms-contact-form-content');
                    const successEl = document.getElementById('cms-contact-success');
                    if (!form || !wrapper || !formContent || !successEl) return;
                    form.addEventListener('submit', (e) => {
                      e.preventDefault();
                      const data = Object.fromEntries(new FormData(form).entries());
                      fetch('/api/submit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                        body: JSON.stringify(data),
                      }).catch(() => {});
                      formContent.style.opacity = '0';
                      formContent.style.transform = 'scale(0.95)';
                      formContent.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                      setTimeout(() => {
                        formContent.classList.add('hidden');
                        wrapper.classList.add('success');
                        successEl.classList.remove('hidden');
                        successEl.classList.add('flex');
                        successEl.style.opacity = '0';
                        successEl.style.transform = 'scale(0.95)';
                        requestAnimationFrame(() => {
                          successEl.style.transition = 'opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s';
                          successEl.style.opacity = '1';
                          successEl.style.transform = 'scale(1)';
                        });
                      }, 300);
                    });
                  })();
                </script>
              </div>
            </div>
        </div>
      </section>
    )}
    {hasEmbed && (
      <section class="mx-auto max-w-[1400px] px-6 pb-8 sm:px-12 lg:px-16 min-w-0">
        <Fragment set:html={meetingEmbed!} />
      </section>
    )}
    {hasBottom && (
      <section class="mx-auto max-w-[900px] px-6 pb-24 sm:px-12 lg:px-16">
        <div class="dynamic-body dynamic-body--docs" set:html={bottomHtml} />
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
