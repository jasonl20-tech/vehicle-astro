---
import { loadLandingPages, loadHeaderFooter } from '../lib/cms-d1-content';
import { getLocaleFromUrl, localizeUrl } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const l = (url: string) => localizeUrl(url, locale);
const cfLocale = locale === 'es' ? 'es' : 'en-US';

interface DynamicLink {
  label: string;
  href: string;
}

interface DynamicCategory {
  name: string;
  links: DynamicLink[];
}

const knownCategories = new Set(['product', 'coverage', 'resources', 'company']);
let dynamicByCategory = new Map<string, DynamicLink[]>();
let extraCategories: DynamicCategory[] = [];

try {
  const res = await loadLandingPages({ locale: cfLocale, limit: 500 });
  const footerItems = res.items.filter((p) => p.footer);

  const catMap = new Map<string, DynamicLink[]>();
  for (const item of footerItems) {
    const category = item.categoryName || 'Other';
    const href = l(`/${item.slug}`);
    const label = item.title || item.slug;
    if (!catMap.has(category)) catMap.set(category, []);
    catMap.get(category)!.push({ label, href });
  }

  for (const [name, links] of catMap) {
    links.sort((a, b) => a.label.localeCompare(b.label));
    if (knownCategories.has(name.toLowerCase())) {
      dynamicByCategory.set(name.toLowerCase(), links);
    } else {
      extraCategories.push({ name, links });
    }
  }
  extraCategories.sort((a, b) => a.name.localeCompare(b.name));
} catch (e) {
  console.warn('[Footer] D1 categories load failed:', e);
}

const MAX_LINKS = 8;
const productExtra = dynamicByCategory.get('product') || [];
const coverageExtra = dynamicByCategory.get('coverage') || [];
const resourcesExtra = dynamicByCategory.get('resources') || [];
const companyExtra = dynamicByCategory.get('company') || [];

const hf = await loadHeaderFooter({ locale: cfLocale }).catch(() => null);

const sectionsToRender: Array<{ key: string; label: string; links: DynamicLink[] }> = [];
if (hf?.productLabel) sectionsToRender.push({ key: 'product', label: hf.productLabel, links: productExtra });
if (hf?.coverageLabel) sectionsToRender.push({ key: 'coverage', label: hf.coverageLabel, links: coverageExtra });
if (hf?.resourcesLabel) sectionsToRender.push({ key: 'resources', label: hf.resourcesLabel, links: resourcesExtra });
if (hf?.companyLabel) sectionsToRender.push({ key: 'company', label: hf.companyLabel, links: companyExtra });
---

<footer class="text-white pt-24 pb-12 w-full border-t border-white/10" style="background-color:rgb(10, 43, 49); font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
  <div class="w-full px-4 sm:px-6 md:px-12 lg:px-20 xl:px-24">
    <div class="w-full mx-auto">
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end mb-20 gap-12 border-b border-white/10 pb-12">
        <div class="max-w-xl">
          {hf?.footerDescription && (
            <p class="text-gray-300 text-lg leading-relaxed mb-8 whitespace-pre-line">{hf.footerDescription}</p>
          )}
          {(hf?.footerButton1Text || hf?.footerButton2Text) && (
            <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
              {hf?.footerButton1Text && (
                <a class="bg-white text-black px-6 py-3 rounded-none font-bold uppercase tracking-widest hover:bg-[rgb(200,90,70)] hover:text-white transition-colors text-center sm:text-left" href={hf.footerButton1Link || '#'}>{hf.footerButton1Text}</a>
              )}
              {hf?.footerButton2Text && (
                <a class="border border-white/30 text-white px-6 py-3 rounded-none font-bold uppercase tracking-widest hover:bg-white/10 transition-colors text-center sm:text-left" href={hf.footerButton2Link || '#'}>{hf.footerButton2Text}</a>
              )}
            </div>
          )}
        </div>
        {(hf?.stayUpdatedLabel || hf?.subscribeLabel) && (
          <div class="w-full lg:w-auto flex flex-col items-center text-center lg:items-end lg:text-left">
            {hf?.stayUpdatedLabel && (
              <p class="text-sm font-bold uppercase tracking-widest text-gray-300 mb-4">{hf.stayUpdatedLabel}</p>
            )}
            <div id="footer-nl-wrapper">
              <div id="footer-nl-content">
                <form id="footer-nl-form" class="flex w-full max-w-sm flex-col sm:flex-row gap-2 sm:max-w-none">
                  <input type="hidden" name="subject" value="Newsletter Subscribe"/>
                  <input type="email" name="email" required class="px-4 py-3 bg-white/5 border border-white/10 text-white placeholder-gray-600 focus:outline-none focus:border-white w-full sm:w-80 rounded-none"/>
                  {hf?.subscribeLabel && (
                    <button type="submit" id="footer-nl-btn" class="px-6 py-3 font-bold uppercase tracking-widest transition-colors rounded-none bg-white text-black hover:bg-gray-200">{hf.subscribeLabel}</button>
                  )}
                </form>
              </div>
              <div id="footer-nl-success" class="hidden items-center gap-3">
                <svg class="h-5 w-5 text-emerald-400" viewBox="0 0 52 52" fill="none">
                  <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-dasharray="150.8" stroke-dashoffset="150.8" class="fnl-circle" />
                  <path d="M15 27L23 35L37 19" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke-dasharray="40" stroke-dashoffset="40" class="fnl-check" />
                </svg>
              </div>
            </div>

            <style>
              @keyframes fnl-dc { to { stroke-dashoffset: 0; } }
              @keyframes fnl-dk { to { stroke-dashoffset: 0; } }
              #footer-nl-wrapper.success .fnl-circle { animation: fnl-dc 0.6s ease-out 0.2s forwards; }
              #footer-nl-wrapper.success .fnl-check { animation: fnl-dk 0.4s ease-out 0.7s forwards; }
            </style>

            <script>
              (function() {
                const form = document.getElementById('footer-nl-form') as HTMLFormElement | null;
                const wrapper = document.getElementById('footer-nl-wrapper');
                const content = document.getElementById('footer-nl-content');
                const success = document.getElementById('footer-nl-success');
                form?.addEventListener('submit', (e) => {
                  e.preventDefault();
                  const data = Object.fromEntries(new FormData(form).entries());
                  fetch('/api/submit', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(data) }).catch(() => {});
                  if (content) { content.style.opacity = '0'; content.style.transition = 'opacity 0.3s ease'; }
                  setTimeout(() => { content?.classList.add('hidden'); wrapper?.classList.add('success'); success?.classList.remove('hidden'); success?.classList.add('flex'); if (success) { success.style.opacity = '0'; requestAnimationFrame(() => { success.style.transition = 'opacity 0.5s ease'; success.style.opacity = '1'; }); } }, 300);
                });
              })();
            </script>
          </div>
        )}
      </div>

      {sectionsToRender.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-8 lg:gap-10 mb-12 items-start">
          {sectionsToRender.map((section) => (
            <div>
              <h4 class="font-bold text-white mb-6 uppercase tracking-widest text-xs opacity-70">{section.label}</h4>
              {section.links.length > 0 && (
                <ul class="space-y-4 text-sm text-gray-300">
                  {section.links.slice(0, MAX_LINKS).map((link) => (
                    <li><a class="hover:text-white transition-colors" href={link.href}>{link.label}</a></li>
                  ))}
                </ul>
              )}
            </div>
          ))}

          {extraCategories.map((cat) => (
            <div>
              <h4 class="font-bold text-white mb-6 uppercase tracking-widest text-xs opacity-70">{cat.name}</h4>
              <ul class="space-y-4 text-sm text-gray-400">
                {cat.links.slice(0, MAX_LINKS).map((link) => (
                  <li><a class="hover:text-white transition-colors" href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}

      {hf?.footerCloser && (
        <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-6">
          <p class="text-sm text-gray-300">{hf.footerCloser}</p>
        </div>
      )}
    </div>
  </div>
</footer>
