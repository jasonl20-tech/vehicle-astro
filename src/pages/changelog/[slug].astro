---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { renderRichText } from '../../lib/contentful-rich-text';
import { loadChangelogs, type ChangelogItem, type AssetMap } from '../../lib/cms-d1-content';

export async function getStaticPaths() {
  try {
    const res = await loadChangelogs({ locale: 'en-US', limit: 500 });
    return res.items.map((c) => ({ params: { slug: c.slug }, props: { entry: c, assetMap: res.assets } }));
  } catch (e) {
    console.warn('[changelog/[slug]] D1 load failed:', e);
    return [];
  }
}

const { entry, assetMap } = Astro.props as { entry: ChangelogItem; assetMap: AssetMap };
const title = entry?.title ?? 'Changelog';
const slug = entry?.slug ?? '';
const body = entry?.body;
const metaTitle = `${title} | Vehicle Imagery Changelog`;
const metaDescription = entry?.excerpt || title;
const ogImageUrl: string | undefined = undefined;
const ogImageAlt = title;
const bodyHtml = body ? renderRichText(body, assetMap) : '';
const createdAt = entry?.date ?? '';
const version = entry?.version;
const category: string | undefined = undefined;
const author: string | undefined = undefined;
const tags: string[] = [];
const featuredImageUrl: string | undefined = undefined;
const featuredImageAlt = title;
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={ogImageUrl}
  ogImageAlt={ogImageAlt}
  canonicalUrl={`/changelog/${slug}`}
>
  <Header />
  <main class="vi-font min-h-screen" style="background-color:rgb(255, 254, 252);">
    <!-- Back link -->
    <div class="max-w-4xl mx-auto px-6 sm:px-8 pt-8">
      <a href="/changelog" class="inline-flex items-center text-sm font-bold uppercase tracking-widest text-gray-500 hover:text-[rgb(200,90,70)] transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        All Changelog Entries
      </a>
    </div>

    <article class="max-w-4xl mx-auto px-6 sm:px-8 py-12 md:py-16">
      <!-- Header -->
      <header class="mb-12">
        <div class="flex flex-wrap items-center gap-3 text-sm mb-4">
          <time class="font-mono text-[rgb(200,90,70)] uppercase tracking-widest font-semibold" datetime={createdAt}>
            {createdAt ? new Date(createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : ''}
          </time>
          {version && (
            <span class="px-3 py-1 rounded text-xs font-bold uppercase tracking-wider text-white" style="background-color:rgb(10, 43, 49);">{version}</span>
          )}
          {category && (
            <span class="px-3 py-1 rounded text-xs font-bold uppercase tracking-wider border border-black/20 text-black/70">{category}</span>
          )}
          {author && <span class="text-gray-500">by {author}</span>}
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-black tracking-tighter leading-[1.05]">{title}</h1>
        {tags.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <span class="text-xs font-mono text-gray-500 bg-black/5 px-2.5 py-1 rounded">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Featured Image -->
      {featuredImageUrl && (
        <figure class="mb-14 -mx-6 sm:mx-0 sm:rounded-xl overflow-hidden shadow-xl">
          <img
            src={featuredImageUrl}
            alt={featuredImageAlt}
            class="w-full h-auto object-cover"
            width="1200"
            height="600"
            loading="eager"
            decoding="async"
          />
        </figure>
      )}

      <!-- Body -->
      {bodyHtml ? (
        <div
          class="prose prose-lg max-w-none
            prose-headings:font-black prose-headings:tracking-tighter prose-headings:text-black
            prose-p:text-gray-700 prose-p:leading-relaxed
            prose-a:text-[rgb(200,90,70)] prose-a:no-underline hover:prose-a:underline prose-a:font-medium
            prose-strong:text-black prose-strong:font-bold
            prose-ul:my-6 prose-ol:my-6 prose-li:my-1
            prose-img:rounded-lg prose-img:shadow-md
            prose-blockquote:border-l-4 prose-blockquote:border-[rgb(200,90,70)] prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:text-gray-600"
          set:html={bodyHtml}
        />
      ) : (
        <p class="text-gray-500 py-8">No content.</p>
      )}

    </article>

    <!-- Footer CTA -->
    <div class="max-w-4xl mx-auto px-6 sm:px-8 pb-20 pt-8 border-t border-black/10">
      <a href="/changelog" class="inline-flex items-center text-sm font-bold uppercase tracking-widest text-black hover:text-[rgb(200,90,70)] transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to Changelog
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
