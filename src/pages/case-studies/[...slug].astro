---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { renderRichText } from '../../lib/rich-text';
import { loadCaseStudies, type CaseStudyItem, type AssetMap } from '../../lib/cms-d1-content';

export async function getStaticPaths() {
  try {
    const res = await loadCaseStudies({ locale: 'en-US', limit: 500 });
    return res.items.map((cs) => ({ params: { slug: cs.slug }, props: { entry: cs, assets: res.assets } }));
  } catch (e) {
    console.warn('[case-studies/[slug]] D1 load failed:', e);
    return [];
  }
}

const { entry, assets } = Astro.props as { entry: CaseStudyItem; assets: AssetMap };
const title = entry?.title ?? 'Case Study';
const body = entry?.body;
const publishedAt = entry?.date;
const company = entry?.company ?? '';
const industry = entry?.industry ?? '';
const noIndex = false;

const pageTitle = entry?.metaTitle || title;
const metaDescription = entry?.metaDescription || undefined;
const siteUrl = Astro.url.origin;
const ogImageUrl = entry?.ogImageUrl;
const ogImageFull = ogImageUrl ? (ogImageUrl.startsWith('http') ? ogImageUrl : `${siteUrl}${ogImageUrl.startsWith('/') ? '' : '/'}${ogImageUrl}`) : undefined;
const featuredImageUrl = ogImageUrl;
const featuredImageAlt = title;
const bodyHtml = body ? renderRichText(body, assets) : '';
const excerptHtml = '';
const articleUrl = `${siteUrl}/case-studies/${entry?.slug}`;

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description: metaDescription || title, url: articleUrl, ...(ogImageFull && { image: ogImageFull }), ...(publishedAt && { datePublished: publishedAt }), author: { '@type': 'Organization', name: 'Vehicle Imagery' }, publisher: { '@type': 'Organization', name: 'Vehicle Imagery', logo: { '@type': 'ImageObject', url: `${siteUrl}/logo.svg` } } };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` }, { '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${siteUrl}/case-studies` }, { '@type': 'ListItem', position: 3, name: pageTitle, item: articleUrl }] };
---

<BaseLayout title={pageTitle} description={metaDescription} ogImage={ogImageFull} ogImageAlt={featuredImageAlt} canonicalUrl={`/case-studies/${entry?.slug}`} noIndex={noIndex}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <main class="min-h-screen bg-cream">
    <header class="relative">
      {featuredImageUrl && (
        <div class="relative h-[50vh] min-h-[320px] max-h-[560px] w-full overflow-hidden bg-[#1C2B32]">
          <img src={featuredImageUrl.startsWith('http') ? featuredImageUrl : `https:${featuredImageUrl}`} alt={featuredImageAlt} class="h-full w-full object-cover" width="1600" height="900" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#1C2B32]/95 via-[#1C2B32]/40 to-transparent" aria-hidden="true" />
        </div>
      )}
      <div class={`mx-auto max-w-6xl px-6 sm:px-12 lg:px-16 ${featuredImageUrl ? '-mt-32 relative z-10 pb-16' : 'pt-16 pb-12'}`}>
        <div class="rounded-none border border-white/10 bg-white p-8 shadow-xl sm:p-10 md:p-12">
          <div class="flex flex-wrap items-center gap-3">
            {company && <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-accent">{company}</span>}
            {industry && <span class="inline-block rounded-none bg-[#1C2B32]/[0.06] px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-[#1C2B32]/60">{industry}</span>}
          </div>
          <h1 class="mt-3 text-3xl font-black leading-tight tracking-tight text-[#1C2B32] sm:text-4xl md:text-5xl">{title}</h1>
          {publishedAt && (
            <div class="mt-8 border-t border-[#1C2B32]/10 pt-8">
              <time datetime={publishedAt} class="text-sm text-[#1C2B32]/60">{new Date(publishedAt).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            </div>
          )}
        </div>
      </div>
    </header>
    {excerptHtml && (
      <div class="mx-auto max-w-6xl px-6 sm:px-12 lg:px-16">
        <div class="border-l-4 border-accent bg-[#1C2B32]/[0.03] py-4 pl-6 pr-6">
          <div class="blog-prose blog-prose--lead text-lg leading-relaxed text-[#1C2B32]/85" set:html={excerptHtml} />
        </div>
      </div>
    )}
    <div class="mx-auto max-w-6xl px-6 pb-16 pt-12 sm:px-12 lg:px-16">
      <article class="min-w-0">
        <a href="/case-studies" class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-[#1C2B32]/60 transition-colors hover:text-accent"><span aria-hidden="true">&larr;</span> Back to case studies</a>
        {bodyHtml ? <div class="blog-prose blog-article-body mt-8" set:html={bodyHtml} /> : <p class="mt-8 text-[#1C2B32]/60">No content.</p>}
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
