---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCompanyInfo } from '../lib/site-config';
import { renderRichText, richTextToPlainText } from '../lib/rich-text';
import { loadChangelogs, loadBlogsWithIncludes, loadMainPage, loadFirmenKonfiguration } from '../lib/cms-d1-content';

const locale = 'en-US';

const [page, company, firma] = await Promise.all([
  loadMainPage({ locale }).catch(() => null),
  getCompanyInfo(),
  loadFirmenKonfiguration({ locale }).catch(() => null),
]);

type UpdateItem = { slug: string; title: string; date: string; excerpt?: string; type: 'changelog' | 'blog' };
let latestUpdates: UpdateItem[] = [];

try {
  const [changelogRes, blogRes] = await Promise.all([
    loadChangelogs({ locale, limit: 10 }).catch(() => ({ items: [] })),
    loadBlogsWithIncludes({ locale, limit: 10 }).catch(() => ({ items: [], includes: {} })),
  ]);

  const changelogs: UpdateItem[] = (changelogRes.items || []).slice(0, 4).map((c) => ({
    slug: c.slug,
    title: c.title,
    date: c.date,
    excerpt: c.excerpt,
    type: 'changelog' as const,
  }));

  const blogs: UpdateItem[] = (blogRes.items || []).slice(0, 4)
    .filter((i) => i.fields?.slug)
    .map((i) => ({
      slug: i.fields.slug,
      title: i.fields.title ?? 'Untitled',
      date: i.fields.publishedAt ?? '',
      excerpt: i.fields.excerpt ? richTextToPlainText(i.fields.excerpt, 120) : undefined,
      type: 'blog' as const,
    }));

  latestUpdates = [...changelogs, ...blogs]
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    .slice(0, 6);
} catch (e) {
  console.warn('[index] D1 latest updates load failed:', e);
}

const siteUrl = Astro.url.origin;
const ogImageAbsolute = page?.ogImageUrl
  ? (page.ogImageUrl.startsWith('http') ? page.ogImageUrl : `${siteUrl}${page.ogImageUrl.startsWith('/') ? '' : '/'}${page.ogImageUrl}`)
  : undefined;

const softwareAppSchema = {
  '@type': 'SoftwareApplication',
  '@id': `${siteUrl}/#software`,
  name: firma?.siteName || 'Vehicle Imagery API',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (REST API)',
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#organization` },
  offers: {
    '@type': 'Offer',
    url: `${siteUrl}/pricing`,
    priceCurrency: 'EUR',
    price: '0',
    description: 'Free trial available, paid plans on request.',
  },
};

const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${siteUrl}/#webpage`,
  url: `${siteUrl}/`,
  name: page?.metaTitle || 'Vehicle Imagery',
  description: page?.metaBeschreibung || '',
  inLanguage: 'en-US',
  isPartOf: { '@id': `${siteUrl}/#website` },
  primaryImageOfPage: ogImageAbsolute ? { '@type': 'ImageObject', url: ogImageAbsolute } : undefined,
  about: { '@id': `${siteUrl}/#software` },
};

const sameAsLinks = [company.twitterUrl, company.facebookUrl, company.linkedinUrl].filter((u): u is string => Boolean(u));

const homepageStructuredData: unknown[] = [
  {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: firma?.firmenName || company.companyName,
    url: siteUrl,
    logo: firma?.logoUrl || `${siteUrl}/logo.svg`,
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: company.phone,
      contactType: 'customer service',
      email: company.emailSupport,
    },
    sameAs: sameAsLinks,
  },
  softwareAppSchema,
  webPageSchema,
];
---

<BaseLayout
  title={page?.metaTitle || 'Vehicle Imagery'}
  description={page?.metaBeschreibung || ''}
  ogImage={ogImageAbsolute}
  canonicalUrl="/"
  structuredDataGraph={homepageStructuredData}
  preloadHero
>
  <Header />

  <style>
    .hero-section {
      --vi-dark: rgb(10, 43, 49);
      --vi-cream: rgb(255, 254, 252);
      --vi-red: rgb(200, 90, 70);
      font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
    }
    @media (min-width: 768px) {
      .hero-section { grid-template-columns: 65% 35%; }
    }
    .vi-font { font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; }
    .dev-body p { font-size: 1.125rem; color: rgb(75 85 99); margin: 0 0 1rem; line-height: 1.7; }
    .dev-body ul { list-style: none; padding: 0; margin: 0 0 2.5rem; }
    .dev-body ul li { display: flex; align-items: center; color: rgb(209 213 219); margin-bottom: 1rem; }
    .dev-body ul li::before { content: ''; display: inline-block; width: 1.25rem; height: 1.25rem; margin-right: 0.75rem; flex-shrink: 0; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='white' stroke-width='2'><path stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7'/></svg>"); background-repeat: no-repeat; background-size: contain; }
    .dev-body p:first-child { color: rgb(209 213 219); }
    .industries-body p { font-size: 0.875rem; color: rgb(75 85 99); line-height: 1.7; margin: 0 0 1em; font-weight: 300; }
    .industries-body strong { color: rgb(0 0 0); font-weight: 500; }
  </style>

  <main id="main-content">

    {!page ? (
      <section class="mx-auto max-w-3xl px-6 py-32 text-center">
        <h1 class="text-3xl font-light text-black mb-4">Vehicle Imagery</h1>
        <p class="text-black/60">No main page content configured.</p>
      </section>
    ) : (
      <>
        <!-- Hero Section -->
        <section class="hero-section relative grid grid-cols-1 min-h-[calc(100svh-5rem)] md:min-h-[calc(100vh-80px)] md:h-[calc(100vh-80px)] overflow-hidden">
          <div class="pointer-events-none absolute left-0 right-0 -top-[2px] z-10" style="height:2px; background-color:var(--vi-dark); background-image:linear-gradient(to right, var(--vi-cream) 0%, var(--vi-cream) 65%, var(--vi-dark) 65%, var(--vi-dark) 100%);"></div>
          <div class="px-5 sm:px-8 md:px-16 flex flex-col justify-center items-start relative w-full order-1 self-stretch min-h-full py-12 sm:py-16 md:py-0" style="background-color:var(--vi-cream);">
            <div class="absolute top-0 left-0 w-full h-px bg-black/5 md:hidden"></div>
            <div class="max-w-[640px] w-full md:mt-[-15%]">
              {page.heroTitle && (
                <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-black mb-6 sm:mb-8 text-black leading-[0.9] tracking-tighter uppercase whitespace-pre-line">{page.heroTitle}</h1>
              )}
              {page.heroDescribtion && (
                <p class="text-base sm:text-lg md:text-xl text-gray-600 mb-8 sm:mb-10 leading-relaxed max-w-lg font-light">{page.heroDescribtion}</p>
              )}
              {(page.heroButton1 || page.heroButton2) && (
                <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 items-start sm:items-center">
                  {page.heroButton1 && (
                    <a class="group relative w-full sm:w-auto text-center sm:text-left px-6 sm:px-8 py-3.5 sm:py-4 text-white text-sm font-bold uppercase tracking-widest overflow-hidden rounded-none" style="background-color:var(--vi-dark);" href={page.heroButton1Link || '#'}>
                      <span class="relative z-10 group-hover:text-white transition-colors">{page.heroButton1}</span>
                      <div class="absolute inset-0 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300" style="background-color:var(--vi-red);"></div>
                    </a>
                  )}
                  {page.heroButton2 && (
                    <a class="group flex items-center text-black text-sm font-bold uppercase tracking-widest transition-colors hover:text-[rgb(200,90,70)]" href={page.heroButton2Link || '#'}>
                      {page.heroButton2}
                      <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
          <div class="hidden md:flex items-center justify-center p-0 relative z-0 overflow-hidden order-2 self-stretch" style="background-color:var(--vi-dark); border-bottom-left-radius: 48px;">
            <div class="absolute inset-0 opacity-20" style="background-image:radial-gradient(#4a4a4a 1px, transparent 1px); background-size:32px 32px; border-radius: inherit;"></div>
          </div>
          {page.heroImageUrl && (
            <div class="hidden md:block absolute inset-0 z-20 pointer-events-none" style="left:65%; transform:translateX(-50%);">
              <img src={page.heroImageUrl} alt={page.heroImageAlt} width="1200" height="805" draggable="false" fetchpriority="high" decoding="async" class="w-auto max-w-none object-contain pointer-events-auto" style="height:58.5%; margin-top:20%; filter:drop-shadow(0 20px 40px rgba(0,0,0,0.3)); user-select:none;"/>
            </div>
          )}
        </section>

        <!-- Vehicle Perspectives Gallery -->
        {(page.perspectiveTitle || page.perspectiveBeschreibung || page.perspectiveImages.length > 0) && (
          <section class="pt-10 sm:pt-16 md:pt-24 pb-0 w-full vi-font overflow-hidden" style="background-color:rgb(255, 254, 252);">
            <div class="w-full">
              {(page.perspectiveTitle || page.perspectiveBeschreibung) && (
                <div class="mb-8 sm:mb-12 md:mb-16 px-4 sm:px-6 md:px-12">
                  {page.perspectiveTitle && (
                    <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-black tracking-tighter leading-none">{page.perspectiveTitle}</h2>
                  )}
                  {page.perspectiveBeschreibung && (
                    <p class="mt-4 text-base sm:text-lg text-gray-600 font-light max-w-2xl">{page.perspectiveBeschreibung}</p>
                  )}
                </div>
              )}
              {page.perspectiveImages.length > 0 && (
                <div class="grid grid-cols-2 md:grid-cols-4 gap-0" style="grid-auto-rows: minmax(220px, 1fr);">
                  {page.perspectiveImages.map((img, i) => (
                    <article class="group relative flex items-center justify-center min-h-[180px]" style={`background-color: ${i % 2 === 0 ? '#f8f8f8' : '#efefef'}`}>
                      <picture class="absolute inset-0 flex items-center justify-center p-2">
                        <img src={img.url} alt={img.alt} class="max-w-full max-h-full w-auto h-auto object-contain" loading={i < 4 ? "eager" : "lazy"} decoding="async" draggable="false" fetchpriority={i === 0 ? "high" : undefined}/>
                      </picture>
                      {img.title && (
                        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex flex-col items-center justify-center">
                          <span class="text-xs font-bold uppercase tracking-widest text-black px-3 py-1.5 bg-white/95 rounded-lg shadow-sm">{img.title}</span>
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              )}
            </div>
          </section>
        )}

        <!-- Developer Experience -->
        {(page.developerTitle || page.developerBeschreibung || page.exampleRequest) && (
          <section class="py-16 sm:py-24 w-full text-white overflow-hidden vi-font" style="background-color:rgb(10, 43, 49);">
            <div class="w-full px-6 sm:px-8 md:px-12 lg:px-16 xl:px-24">
              <div class="w-full mx-auto max-w-[1400px]">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                  <div>
                    {page.developerTitle && (
                      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-6 tracking-tighter">{page.developerTitle}</h2>
                    )}
                    {page.developerBeschreibung && (
                      <div class="dev-body" set:html={renderRichText(page.developerBeschreibung, page.assets)} />
                    )}
                    {page.developerButtonText && (
                      <a class="inline-block bg-white text-black px-8 py-4 rounded-none font-bold uppercase tracking-widest hover:bg-[rgb(200,90,70)] hover:text-white transition-colors" href={page.developerButtonLink || '#'}>{page.developerButtonText}</a>
                    )}
                  </div>
                  {page.exampleRequest && (
                    <div class="bg-[#1e1e1e] shadow-2xl overflow-hidden border border-white/10">
                      <div class="flex items-center px-6 py-4 bg-[#252526] border-b border-white/5">
                        <div class="flex space-x-2 mr-4">
                          <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
                          <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
                          <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
                        </div>
                      </div>
                      <pre class="p-8 font-mono text-sm leading-relaxed overflow-x-auto text-gray-300 whitespace-pre"><code>{page.exampleRequest}</code></pre>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Industries -->
        {(page.industriesTitle || page.industriesBeschreibung || page.industriesNote || page.industriesText) && (
          <section class="border-t border-black/10 py-16 md:py-32 text-black w-full vi-font" style="background-color:rgb(255, 254, 252);">
            <div class="w-full px-6 sm:px-8 md:px-12 lg:px-16 xl:px-24">
              <div class="w-full mx-auto max-w-[1400px]">
                <div class="flex flex-col md:flex-row gap-16 items-start">
                  <div class="md:w-1/3 md:sticky md:top-32">
                    {page.industriesTitle && (
                      <h2 class="text-4xl sm:text-5xl font-black mb-6 text-black tracking-tighter leading-none whitespace-pre-line">{page.industriesTitle}</h2>
                    )}
                    {page.industriesBeschreibung && (
                      <p class="text-lg text-gray-600 max-w-sm mb-8">{page.industriesBeschreibung}</p>
                    )}
                    {page.industriesNote && (
                      <div class="hidden md:block max-w-sm mt-12 p-6 bg-[#fafafa] border border-black/5 shadow-sm relative transform -rotate-1 hover:rotate-0 transition-transform duration-500">
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-16 h-6 bg-black/5 backdrop-blur-sm border border-black/5 rotate-2"></div>
                        <p class="text-sm text-gray-600 leading-relaxed font-light whitespace-pre-line">{page.industriesNote}</p>
                      </div>
                    )}
                  </div>
                  {page.industriesText && (
                    <div class="md:w-2/3">
                      <div class="industries-body text-base text-gray-700 leading-relaxed" set:html={renderRichText(page.industriesText, page.assets)} />
                    </div>
                  )}
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Transparent Background -->
        {(page.transparentTitle || page.transparentBeschreibung) && (
          <section class="border-t border-black/5 py-16 md:py-24 w-full vi-font" style="background-color:rgb(255, 254, 252);">
            <div class="w-full px-6 sm:px-8 md:px-12 lg:px-16 xl:px-8">
              <div class="max-w-[1400px] mx-auto">
                <div class="mb-8 text-center">
                  {page.transparentTitle && (
                    <h2 class="text-3xl sm:text-4xl font-black mb-4 text-black tracking-tighter uppercase">{page.transparentTitle}</h2>
                  )}
                  {page.transparentBeschreibung && (
                    <p class="text-gray-600 max-w-2xl mx-auto">{page.transparentBeschreibung}</p>
                  )}
                </div>
                <div id="before-after-slider" class="relative w-full aspect-[16/9] overflow-hidden shadow-2xl cursor-ew-resize select-none">
                  <div class="absolute inset-0 bg-white" id="slider-left" style="clip-path:inset(0 50% 0 0);"></div>
                  <div class="absolute inset-0 z-0" id="slider-right" style="clip-path:inset(0 0 0 50%);">
                    <picture><source srcset="/images/showroom.webp" type="image/webp" /><img alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" style="transform:scale(1.3);" src="/images/showroom.png" draggable="false"/></picture>
                  </div>
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20">
                    <div class="relative w-full h-full flex items-center justify-center px-4">
                      <img src="/images/peugot.png" alt="" class="max-w-full max-h-full w-auto h-auto object-contain" loading="eager" draggable="false" style="filter:drop-shadow(0 25px 50px rgba(0,0,0,0.3));"/>
                    </div>
                  </div>
                  <div class="absolute top-0 bottom-0 w-px bg-white/50 shadow-lg z-[5]" id="slider-handle" style="left:50%; transform:translateX(-50%);">
                    <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 w-12 h-12 bg-white shadow-xl flex items-center justify-center border-2 border-gray-200 z-20">
                      <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7M18 19l-7-7 7-7"></path></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Vehicle Colors -->
        {(page.colorTitle || page.colorBeschreibung) && (
          <section class="relative border-t border-black/10 pt-8 md:pt-12 pb-0 w-full overflow-hidden vi-font">
            <div class="absolute inset-0 bg-[#fdfbf7]"></div>
            <div class="absolute inset-0 opacity-[0.15]" style="background-image:radial-gradient(circle, #000 1px, transparent 1px); background-size:32px 32px;"></div>
            <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[80%] rounded-full bg-blue-200/20 blur-[100px] pointer-events-none mix-blend-multiply"></div>
            <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[80%] rounded-full bg-[rgb(200,90,70)]/10 blur-[100px] pointer-events-none mix-blend-multiply"></div>
            <div class="w-full px-6 sm:px-12 md:px-16 lg:px-20 xl:px-24 relative z-10">
              <div class="max-w-[1200px] mx-auto text-center">
                <div class="mb-20 md:mb-32">
                  {page.colorTitle && (
                    <h2 class="text-4xl sm:text-5xl lg:text-7xl font-black mb-4 text-black tracking-tighter uppercase leading-[0.9]">{page.colorTitle}</h2>
                  )}
                  {page.colorBeschreibung && (
                    <div class="max-w-3xl mx-auto">
                      <p class="text-lg sm:text-xl text-gray-600 leading-relaxed font-light">{page.colorBeschreibung}</p>
                    </div>
                  )}
                </div>
                <div class="relative z-10">
                  <picture><source srcset="/images/vehicle_colors_api.webp" type="image/webp" /><img alt="" loading="lazy" decoding="async" width="1200" height="426" class="w-full h-auto object-cover block" src="/images/vehicle_colors_api.png" draggable="false"/></picture>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Try it Free -->
        {(page.freeTitle || page.freeBeschreibung || page.freeButton) && (
          <section class="bg-[#1a1a1a] py-12 sm:py-16 text-white w-full relative z-20 mt-[-2px] vi-font">
            <div class="w-full px-6 sm:px-12 md:px-16 lg:px-24 xl:px-64 text-center">
              <div class="max-w-[1024px] mx-auto">
                {page.freeTitle && (
                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-3 sm:mb-4">{page.freeTitle}</h2>
                )}
                {page.freeBeschreibung && (
                  <p class="text-base sm:text-lg text-gray-300 mb-6 sm:mb-8">{page.freeBeschreibung}</p>
                )}
                <div id="idx-trial-wrapper">
                  <div id="idx-trial-content">
                    <form id="idx-trial-form" class="flex flex-col sm:flex-row gap-0 max-w-lg mx-auto border-b border-white/20 pb-2">
                      <input type="hidden" name="subject" value="Free Trial Request"/>
                      <input type="email" name="email" required placeholder="company@email.com" class="flex-1 px-4 py-3 bg-transparent text-white placeholder-gray-500 focus:outline-none text-lg"/>
                      {page.freeButton && (
                        <button type="submit" id="idx-trial-btn" class="group inline-flex items-center justify-center gap-2 px-6 py-3 font-semibold whitespace-nowrap uppercase tracking-widest text-sm transition-colors text-white hover:text-[rgb(200,90,70)]">
                          {page.freeButton}
                          <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                          </svg>
                        </button>
                      )}
                    </form>
                    {page.freeEmailDescribtion && (
                      <p class="text-xs sm:text-sm text-gray-600 mt-3 sm:mt-4">{page.freeEmailDescribtion}</p>
                    )}
                  </div>
                  <div id="idx-trial-success" class="hidden items-center justify-center gap-3 py-4">
                    <svg class="h-6 w-6 text-emerald-400" viewBox="0 0 52 52" fill="none">
                      <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-dasharray="150.8" stroke-dashoffset="150.8" class="idx-trial-circle" />
                      <path d="M15 27L23 35L37 19" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke-dasharray="40" stroke-dashoffset="40" class="idx-trial-check" />
                    </svg>
                  </div>
                </div>

                <style>
                  @keyframes idx-trial-dc { to { stroke-dashoffset: 0; } }
                  @keyframes idx-trial-dk { to { stroke-dashoffset: 0; } }
                  #idx-trial-wrapper.success .idx-trial-circle { animation: idx-trial-dc 0.6s ease-out 0.2s forwards; }
                  #idx-trial-wrapper.success .idx-trial-check { animation: idx-trial-dk 0.4s ease-out 0.7s forwards; }
                </style>

                <script>
                  (function() {
                    const form = document.getElementById('idx-trial-form');
                    const wrapper = document.getElementById('idx-trial-wrapper');
                    const content = document.getElementById('idx-trial-content');
                    const success = document.getElementById('idx-trial-success');
                    if (!form || !wrapper || !content || !success) return;
                    form.addEventListener('submit', (e) => {
                      e.preventDefault();
                      const data = Object.fromEntries(new FormData(form).entries());
                      fetch('/api/submit', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(data) }).catch(() => {});
                      content.style.opacity = '0'; content.style.transition = 'opacity 0.3s ease';
                      setTimeout(() => { content.classList.add('hidden'); wrapper.classList.add('success'); success.classList.remove('hidden'); success.classList.add('flex'); success.style.opacity = '0'; requestAnimationFrame(() => { success.style.transition = 'opacity 0.5s ease'; success.style.opacity = '1'; }); }, 300);
                    });
                  })();
                </script>
              </div>
            </div>
          </section>
        )}

        <!-- Contact Section -->
        {(page.contactTitle || page.contactBeschreibung || page.contactDemoLinkBeschreibung) && (
          <section id="contact" class="py-24 md:py-32 w-full bg-[#F5F5F7] vi-font">
            <div class="w-full px-4 sm:px-6 md:px-8">
              <div class="max-w-[1200px] mx-auto">
                <div class="bg-white rounded-[2px] shadow-2xl overflow-hidden flex flex-col lg:flex-row">
                  <div class="lg:w-[40%] p-10 sm:p-12 lg:p-16 text-white relative overflow-hidden" style="background-color:rgb(10, 43, 49);">
                    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 rounded-full bg-white/5 blur-3xl pointer-events-none"></div>
                    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-[rgb(200,90,70)]/20 blur-3xl pointer-events-none"></div>
                    <div class="relative z-10 h-full flex flex-col justify-between">
                      <div>
                        {page.contactTitle && (
                          <h2 class="text-3xl sm:text-4xl font-black mb-6 tracking-tighter text-white">{page.contactTitle}</h2>
                        )}
                        {page.contactBeschreibung && (
                          <p class="text-gray-300 leading-relaxed font-light text-lg">{page.contactBeschreibung}</p>
                        )}
                      </div>
                      {page.contactDemoLinkBeschreibung && (
                        <div class="mt-12">
                          <a class="group inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-white hover:text-[rgb(200,90,70)] transition-colors" href="/book-a-call">
                            {page.contactDemoLinkBeschreibung}
                            <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                          </a>
                        </div>
                      )}
                    </div>
                  </div>
                  <div id="idx-contact-wrapper" class="lg:w-[60%] p-10 sm:p-12 lg:p-16 transition-all duration-700 ease-out">
                    <div id="idx-contact-content">
                      <form id="idx-contact-form" class="space-y-6">
                        <input type="hidden" name="subject" value="Contact Form"/>
                        <div>
                          {page.contactNamePlaceholder && (
                            <label for="idx-contact-name" class="block text-xs font-bold text-gray-600 mb-2 uppercase tracking-widest">{page.contactNamePlaceholder}</label>
                          )}
                          <input id="idx-contact-name" type="text" name="name" required placeholder="your name.." class="w-full bg-gray-50 border border-gray-200 rounded-[2px] px-4 py-3 text-black focus:border-[rgb(200,90,70)] focus:ring-1 focus:ring-[rgb(200,90,70)] focus:outline-none transition-all"/>
                        </div>
                        <div>
                          {page.contactEmailPlaceholder && (
                            <label for="idx-contact-email" class="block text-xs font-bold text-gray-600 mb-2 uppercase tracking-widest">{page.contactEmailPlaceholder}</label>
                          )}
                          <input id="idx-contact-email" type="email" name="email" required placeholder="company@email.com" class="w-full bg-gray-50 border border-gray-200 rounded-[2px] px-4 py-3 text-black focus:border-[rgb(200,90,70)] focus:ring-1 focus:ring-[rgb(200,90,70)] focus:outline-none transition-all"/>
                        </div>
                        <div>
                          {page.contactMessagePlaceholder && (
                            <label for="idx-contact-message" class="block text-xs font-bold text-gray-600 mb-2 uppercase tracking-widest">{page.contactMessagePlaceholder}</label>
                          )}
                          <textarea id="idx-contact-message" rows="4" name="message" placeholder="..." class="w-full bg-gray-50 border border-gray-200 rounded-[2px] px-4 py-3 text-black focus:border-[rgb(200,90,70)] focus:ring-1 focus:ring-[rgb(200,90,70)] focus:outline-none transition-all resize-none"></textarea>
                        </div>
                        <div class="pt-2">
                          <button type="submit" id="idx-contact-btn" class="w-full px-8 py-4 rounded-[2px] text-sm font-bold uppercase tracking-widest transition-colors shadow-lg bg-black text-white hover:bg-[rgb(200,90,70)] hover:shadow-xl transform hover:-translate-y-0.5 duration-200">{page.contactSendButton || '\u00a0'}</button>
                        </div>
                      </form>
                    </div>

                    <div id="idx-contact-success" class="hidden flex-col items-center justify-center text-center py-16">
                      <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-emerald-100">
                        <svg class="h-10 w-10 text-emerald-600" viewBox="0 0 52 52" fill="none">
                          <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-dasharray="150.8" stroke-dashoffset="150.8" class="idx-contact-circle" />
                          <path d="M15 27L23 35L37 19" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke-dasharray="40" stroke-dashoffset="40" class="idx-contact-check" />
                        </svg>
                      </div>
                    </div>
                  </div>

                  <style>
                    @keyframes idx-contact-dc { to { stroke-dashoffset: 0; } }
                    @keyframes idx-contact-dk { to { stroke-dashoffset: 0; } }
                    #idx-contact-wrapper.success .idx-contact-circle { animation: idx-contact-dc 0.6s ease-out 0.2s forwards; }
                    #idx-contact-wrapper.success .idx-contact-check { animation: idx-contact-dk 0.4s ease-out 0.7s forwards; }
                  </style>

                  <script>
                    (function() {
                      const form = document.getElementById('idx-contact-form');
                      const wrapper = document.getElementById('idx-contact-wrapper');
                      const formContent = document.getElementById('idx-contact-content');
                      const successEl = document.getElementById('idx-contact-success');
                      if (!form || !wrapper || !formContent || !successEl) return;
                      form.addEventListener('submit', (e) => {
                        e.preventDefault();
                        const data = Object.fromEntries(new FormData(form).entries());
                        fetch('/api/submit', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(data) }).catch(() => {});
                        formContent.style.opacity = '0'; formContent.style.transform = 'scale(0.95)'; formContent.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                        setTimeout(() => { formContent.classList.add('hidden'); wrapper.classList.add('success'); wrapper.style.backgroundColor = '#f0fdf4'; successEl.classList.remove('hidden'); successEl.classList.add('flex'); successEl.style.opacity = '0'; successEl.style.transform = 'scale(0.95)'; requestAnimationFrame(() => { successEl.style.transition = 'opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s'; successEl.style.opacity = '1'; successEl.style.transform = 'scale(1)'; }); }, 300);
                      });
                    })();
                  </script>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Latest Updates -->
        {(page.latestUpdatesTitle || latestUpdates.length > 0) && (
          <section class="border-t border-black/10 pt-16 md:pt-24 w-full vi-font overflow-hidden" style="background-color:rgb(255, 254, 252);">
            <div class="w-full px-8 md:px-12 lg:px-16 mb-12">
              <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 w-full">
                {page.latestUpdatesTitle && (
                  <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-black tracking-tighter leading-none shrink-0">{page.latestUpdatesTitle}</h2>
                )}
                <div class="flex flex-wrap gap-4 sm:gap-6 sm:justify-end">
                  {page.viewArchiveLabel && (
                    <a href="/changelog" class="group inline-flex items-center gap-1.5 text-sm font-bold uppercase tracking-widest text-black/60 hover:text-[rgb(200,90,70)] transition-colors">
                      {page.viewArchiveLabel}
                      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  )}
                  {page.blogLabel && (
                    <a href="/blog" class="group inline-flex items-center gap-1.5 text-sm font-bold uppercase tracking-widest text-black/60 hover:text-[rgb(200,90,70)] transition-colors">
                      {page.blogLabel}
                      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  )}
                  {page.changelogLabel && (
                    <a href="/changelog" class="group inline-flex items-center gap-1.5 text-sm font-bold uppercase tracking-widest text-black/60 hover:text-[rgb(200,90,70)] transition-colors">
                      {page.changelogLabel}
                      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
            {latestUpdates.length > 0 && (
              <div class="w-full grid grid-cols-1 md:grid-cols-3">
                {latestUpdates.slice(0, 3).map((item) => (
                    <a
                      href={item.type === 'changelog' ? `/changelog/${item.slug}` : `/blog/${item.slug}`}
                      class="group block hover:bg-gray-50 transition-colors p-8 md:p-12 lg:p-16 h-full border-r border-transparent md:border-black/5 last:border-r-0"
                    >
                      <div class="flex flex-wrap items-center gap-2 mb-2">
                        <time class="text-xs font-mono text-gray-600" datetime={item.date}>
                          {item.date ? new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : ''}
                        </time>
                      </div>
                      <h3 class="text-lg sm:text-xl font-bold text-black group-hover:text-[rgb(200,90,70)] transition-colors mb-2">{item.title}</h3>
                      {item.excerpt && (
                        <p class="text-sm text-gray-600 leading-relaxed mb-4">{item.excerpt}</p>
                      )}
                      {page.itemCtaLabel && (
                        <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-black/60 group-hover:text-[rgb(200,90,70)] transition-colors">
                          {page.itemCtaLabel}
                          <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                          </svg>
                        </span>
                      )}
                    </a>
                ))}
              </div>
            )}
          </section>
        )}
      </>
    )}

  </main>
  <Footer />

  <script>
    const slider = document.getElementById('before-after-slider');
    if (slider) {
      const handle = document.getElementById('slider-handle');
      const left = document.getElementById('slider-left');
      const right = document.getElementById('slider-right');
      let isDragging = false;
      function updateSlider(x: number) {
        const rect = slider.getBoundingClientRect();
        let pct = ((x - rect.left) / rect.width) * 100;
        pct = Math.max(0, Math.min(100, pct));
        if (handle) handle.style.left = pct + '%';
        if (left) left.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
        if (right) right.style.clipPath = `inset(0 0 0 ${pct}%)`;
      }
      slider.addEventListener('mousedown', (e: MouseEvent) => { isDragging = true; updateSlider(e.clientX); });
      document.addEventListener('mousemove', (e: MouseEvent) => { if (isDragging) updateSlider(e.clientX); });
      document.addEventListener('mouseup', () => { isDragging = false; });
      slider.addEventListener('touchstart', (e: TouchEvent) => { isDragging = true; updateSlider(e.touches[0].clientX); });
      document.addEventListener('touchmove', (e: TouchEvent) => { if (isDragging) updateSlider(e.touches[0].clientX); });
      document.addEventListener('touchend', () => { isDragging = false; });
    }
  </script>
</BaseLayout>
