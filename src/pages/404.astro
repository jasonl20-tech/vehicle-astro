---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadFirmenKonfiguration } from '../lib/cms-d1-content';
import { getLocaleFromUrl, localizeUrl } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const l = (path: string) => localizeUrl(path, locale);
const cfLocale = locale === 'es' ? 'es' : 'en-US';
const firma = await loadFirmenKonfiguration({ locale: cfLocale }).catch(() => null);

const attemptedPath = `${Astro.url.pathname}${Astro.url.search}`;
const formSubject = '404 Page — Contact request';
---

<BaseLayout
  title="Page not found (404) | Vehicle Imagery"
  description="The page you requested could not be found. Return to the homepage, book a call, or send us a quick message."
  noIndex={true}
>
  <Header />

  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    <!-- Hero: error + logo + CTAs -->
    <section class="relative overflow-hidden border-b border-white/10" style="background-color: rgb(10, 43, 49);">
      <div class="pointer-events-none absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 24px 24px;" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[rgb(200,90,70)]/15 via-transparent to-transparent" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-[1400px] px-6 py-16 sm:px-10 sm:py-20 lg:px-16 lg:py-24">
        <div class="flex flex-col items-center text-center">
          {firma?.logoUrl ? (
            <a href={l('/')} class="mb-10 inline-flex transition-opacity hover:opacity-90" aria-label={firma.firmenName || 'Home'}>
              <img
                src={firma.logoUrl}
                alt={firma.firmenName || ''}
                class="h-10 w-auto sm:h-12 brightness-0 invert"
                loading="eager"
                decoding="async"
                draggable="false"
              />
            </a>
          ) : (
            <a href={l('/')} class="mb-10 text-xl font-bold tracking-tight text-white sm:text-2xl">Vehicle Imagery</a>
          )}

          <p class="mb-4 text-[11px] font-bold uppercase tracking-[0.2em] text-white/45">Error</p>
          <h1 class="mb-4 text-7xl font-light tracking-tighter text-white sm:text-8xl md:text-9xl" style="text-shadow: 0 0 80px rgba(0,0,0,0.35);">404</h1>
          <p class="mb-3 max-w-lg text-lg text-white/90 sm:text-xl">This page doesn’t exist or may have been moved.</p>
          <p class="mb-10 max-w-md text-sm text-white/50">
            The URL you tried to open is not available. You can go back to the homepage, schedule a call with our team, or tell us what you were looking for — we’ll get back to you.
          </p>

          <div class="flex w-full max-w-lg flex-col gap-3 sm:flex-row sm:justify-center sm:gap-4">
            <a
              href={l('/')}
              class="inline-flex items-center justify-center border border-white/20 bg-white px-8 py-4 text-[13px] font-bold uppercase tracking-widest text-[rgb(10,43,49)] transition-colors hover:bg-[rgb(200,90,70)] hover:text-white"
            >
              Back to homepage
            </a>
            <a
              href={l('/book-a-call')}
              class="inline-flex items-center justify-center border border-white/30 px-8 py-4 text-[13px] font-bold uppercase tracking-widest text-white transition-colors hover:border-white/50 hover:bg-white/10"
            >
              Book a meeting
            </a>
          </div>
          <a href="#404-contact" class="mt-8 text-[13px] font-medium text-white/45 underline-offset-4 transition-colors hover:text-[rgb(200,90,70)] hover:underline">
            Or send a quick message
          </a>
        </div>
      </div>
    </section>

    <!-- Contact form: same pipeline as other forms → D1 `submissions` via /api/submit -->
    <section id="404-contact" class="mx-auto max-w-[1400px] px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
      <div class="mx-auto max-w-2xl">
        <h2 class="mb-2 text-center text-2xl font-light tracking-tight text-black sm:text-3xl">Need help finding something?</h2>
        <p class="mb-10 text-center text-[15px] text-black/50">Leave a short message and we’ll help you find the right page or resource.</p>

        <div id="404-contact-wrapper" class="overflow-hidden rounded-[1.5rem] border border-black/[0.08] bg-[rgb(255,254,252)] shadow-[0_24px_80px_-32px_rgba(10,43,49,0.2)]">
          <div id="404-contact-inner" class="p-8 sm:p-10">
            <div id="404-contact-form-wrap">
              <form id="404-contact-form" class="space-y-6">
                <input type="hidden" name="subject" value={formSubject} />
                <input type="hidden" name="attemptedPath" value={attemptedPath} />
                <input type="hidden" name="referrer" id="404-form-referrer" value="" />

                <div>
                  <label for="404-name" class="mb-2 block text-xs font-bold uppercase tracking-widest text-black/55">Name</label>
                  <input
                    id="404-name"
                    type="text"
                    name="name"
                    required
                    autocomplete="name"
                    placeholder="Your name"
                    class="w-full rounded-[2px] border border-black/10 bg-white px-4 py-3 text-black placeholder:text-black/35 focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                  />
                </div>
                <div>
                  <label for="404-email" class="mb-2 block text-xs font-bold uppercase tracking-widest text-black/55">Email</label>
                  <input
                    id="404-email"
                    type="email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="you@company.com"
                    class="w-full rounded-[2px] border border-black/10 bg-white px-4 py-3 text-black placeholder:text-black/35 focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                  />
                </div>
                <div>
                  <label for="404-message" class="mb-2 block text-xs font-bold uppercase tracking-widest text-black/55">What were you looking for?</label>
                  <textarea
                    id="404-message"
                    name="message"
                    rows="4"
                    required
                    placeholder="Tell us which page or resource you expected…"
                    class="w-full resize-none rounded-[2px] border border-black/10 bg-white px-4 py-3 text-black placeholder:text-black/35 focus:border-[rgb(200,90,70)] focus:outline-none focus:ring-1 focus:ring-[rgb(200,90,70)]"
                  ></textarea>
                </div>
                <button
                  type="submit"
                  id="404-submit-btn"
                  class="w-full rounded-[2px] bg-black px-8 py-4 text-sm font-bold uppercase tracking-widest text-white shadow-lg transition-all hover:bg-[rgb(200,90,70)]"
                >
                  Send message
                </button>
              </form>
            </div>

            <div id="404-contact-success" class="hidden flex-col items-center justify-center py-12 text-center">
              <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-emerald-100">
                <svg class="h-10 w-10 text-emerald-600" viewBox="0 0 52 52" fill="none">
                  <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-dasharray="150.8" stroke-dashoffset="150.8" class="err404-circle" />
                  <path d="M15 27L23 35L37 19" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke-dasharray="40" stroke-dashoffset="40" class="err404-check" />
                </svg>
              </div>
              <p class="text-lg font-medium text-black">Thank you</p>
              <p class="mt-2 max-w-sm text-[15px] text-black/50">We’ve received your message and will reply as soon as we can.</p>
            </div>
          </div>
        </div>

        <style>
          @keyframes err404-dc { to { stroke-dashoffset: 0; } }
          @keyframes err404-dk { to { stroke-dashoffset: 0; } }
          #404-contact-wrapper.done .err404-circle { animation: err404-dc 0.6s ease-out 0.2s forwards; }
          #404-contact-wrapper.done .err404-check { animation: err404-dk 0.4s ease-out 0.7s forwards; }
        </style>

        <script is:inline>
          (function () {
            var ref = document.getElementById('404-form-referrer');
            if (ref && document.referrer) ref.value = document.referrer;
          })();
        </script>

        <script>
          (function () {
            const form = document.getElementById('404-contact-form');
            const wrapper = document.getElementById('404-contact-wrapper');
            const formWrap = document.getElementById('404-contact-form-wrap');
            const success = document.getElementById('404-contact-success');
            const inner = document.getElementById('404-contact-inner');
            if (!form || !wrapper || !formWrap || !success || !inner) return;
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              const data = Object.fromEntries(new FormData(form).entries());
              fetch('/api/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify(data),
              }).catch(() => {});
              formWrap.style.opacity = '0';
              formWrap.style.transform = 'scale(0.98)';
              formWrap.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
              setTimeout(() => {
                formWrap.classList.add('hidden');
                wrapper.classList.add('done');
                inner.style.backgroundColor = '#f0fdf4';
                success.classList.remove('hidden');
                success.classList.add('flex');
              }, 260);
            });
          })();
        </script>
      </div>
    </section>

    <!-- Helpful links -->
    <section class="border-t border-black/5 bg-white pb-20 pt-4">
      <p class="mb-8 text-center text-[11px] font-medium uppercase tracking-[0.2em] text-black/35">Helpful links</p>
      <div class="mx-auto grid max-w-4xl grid-cols-2 gap-4 px-6 sm:grid-cols-4 sm:gap-6">
        <a href={l('/documentation')} class="block rounded-2xl border border-black/[0.06] bg-black/[0.02] p-4 text-center transition-colors hover:bg-black/[0.05]">
          <span class="block text-[13px] font-medium text-black">Documentation</span>
          <span class="mt-1 block text-[12px] text-black/45">API reference</span>
        </a>
        <a href={l('/pricing')} class="block rounded-2xl border border-black/[0.06] bg-black/[0.02] p-4 text-center transition-colors hover:bg-black/[0.05]">
          <span class="block text-[13px] font-medium text-black">Pricing</span>
          <span class="mt-1 block text-[12px] text-black/45">Plans &amp; trial</span>
        </a>
        <a href={l('/faq')} class="block rounded-2xl border border-black/[0.06] bg-black/[0.02] p-4 text-center transition-colors hover:bg-black/[0.05]">
          <span class="block text-[13px] font-medium text-black">FAQ</span>
          <span class="mt-1 block text-[12px] text-black/45">Common questions</span>
        </a>
        <a href={l('/blog')} class="block rounded-2xl border border-black/[0.06] bg-black/[0.02] p-4 text-center transition-colors hover:bg-black/[0.05]">
          <span class="block text-[13px] font-medium text-black">Blog</span>
          <span class="mt-1 block text-[12px] text-black/45">Updates</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
