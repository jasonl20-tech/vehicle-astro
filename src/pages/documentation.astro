---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadDocumentationPage } from '../lib/cms-d1-content';
import { renderRichText } from '../lib/rich-text';

const page = await loadDocumentationPage({ locale: 'en-US' }).catch(() => null);

const allSlugs: string[] = page
  ? [...page.otherElements.map((e) => e.slug), ...page.endpoints.map((e) => e.slug)]
  : [];
const initialSlug = allSlugs[0] ?? '';

const siteUrl = Astro.url.origin;
const docUrl = `${siteUrl}/documentation`;
const ogImage = page?.ogImageUrl
  ? (page.ogImageUrl.startsWith('http') ? page.ogImageUrl : `${siteUrl}${page.ogImageUrl.startsWith('/') ? '' : '/'}${page.ogImageUrl}`)
  : undefined;

const techArticleSchema: Record<string, unknown> = {
  '@type': 'TechArticle',
  '@id': `${docUrl}#techarticle`,
  headline: page?.title || 'Documentation',
  description: page?.metaDescribtion || page?.describtion || '',
  url: docUrl,
  inLanguage: 'en-US',
  isPartOf: { '@id': `${siteUrl}/#website` },
  publisher: { '@id': `${siteUrl}/#organization` },
};
if (ogImage) techArticleSchema.image = ogImage;

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${docUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: page?.title || 'Documentation', item: docUrl },
  ],
};

const docStructuredData: unknown[] = [techArticleSchema, breadcrumbSchema];
---

<BaseLayout
  title={page?.metaTitle || page?.title || 'Documentation'}
  description={page?.metaDescribtion || ''}
  canonicalUrl="/documentation"
  ogImage={ogImage}
  structuredDataGraph={docStructuredData}
>
  <Header />
  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">

    {!page ? (
      <section class="mx-auto max-w-3xl px-6 py-32 text-center">
        <h1 class="text-3xl font-light text-black mb-4">Documentation</h1>
        <p class="text-black/60">No documentation content configured.</p>
      </section>
    ) : (
      <>
        <!-- Hero -->
        <section class="px-4 pt-6 pb-10 sm:px-8 lg:px-12">
          <div class="mx-auto max-w-[1400px]">
            <div class="relative overflow-hidden rounded-[2rem] sm:rounded-[2.5rem]" style="background-color: rgb(10, 43, 49);">
              <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>
              <div class="relative flex min-h-[320px] flex-col justify-end px-8 py-10 sm:min-h-[400px] sm:px-16 sm:py-16 lg:min-h-[440px]">
                <h1 class="text-5xl font-light tracking-tight text-white sm:text-7xl md:text-8xl">{page.title}</h1>
                {page.describtion && (
                  <p class="mt-4 text-white/60 text-base sm:text-lg max-w-xl leading-relaxed">{page.describtion}</p>
                )}
              </div>
            </div>
          </div>
        </section>

        <!-- Navigation + Content -->
        <section class="mx-auto max-w-[1400px] px-6 pb-24 pt-4 sm:px-12 lg:px-16">
          <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-stretch">

            <!-- Sidebar Navigation -->
            <aside class="w-full lg:w-64 shrink-0 order-2 lg:order-1">
              <nav class="lg:sticky lg:top-24 rounded-2xl bg-[#f4f4f5] p-6 border border-black/[0.06] h-fit">
                <ul class="space-y-0.5" id="doc-nav">
                  {page.otherElements.length > 0 && (
                    <>
                      {page.elementsTitleName && (
                        <li>
                          <span class="block py-2 px-3 text-[10px] font-medium text-black/40 uppercase tracking-widest">{page.elementsTitleName}</span>
                        </li>
                      )}
                      {page.otherElements.map((extra) => (
                        <li>
                          <a href={`#${extra.slug}`} data-doc-link={extra.slug} class="doc-nav-link block py-2.5 px-3 text-[13px] text-black/70 hover:text-black hover:bg-white rounded-lg transition-colors border border-transparent hover:border-black/5">{extra.name}</a>
                        </li>
                      ))}
                    </>
                  )}

                  {page.endpoints.length > 0 && (
                    <>
                      {page.endpointsTitleName && (
                        <li class={page.otherElements.length > 0 ? 'pt-4 mt-2 border-t border-black/5' : ''}>
                          <span class="block py-2 px-3 text-[10px] font-medium text-black/40 uppercase tracking-widest">{page.endpointsTitleName}</span>
                        </li>
                      )}
                      {page.endpoints.map((ep) => (
                        <li>
                          <a href={`#${ep.slug}`} data-doc-link={ep.slug} class="doc-nav-link group flex items-center gap-2.5 py-2.5 px-3 text-[13px] text-black/70 hover:text-black hover:bg-white rounded-lg transition-colors border border-transparent hover:border-black/5">
                            {ep.type && (
                              <span class="text-[9px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded font-mono shrink-0">{ep.type}</span>
                            )}
                            <span class="truncate">{ep.title}</span>
                          </a>
                        </li>
                      ))}
                    </>
                  )}
                </ul>
              </nav>
            </aside>

            <!-- Main Content -->
            <div id="doc-content" class="flex-1 min-w-0 max-w-3xl order-1 lg:order-2">
              <style is:global>
                #doc-content .doc-section { display: none; }
                #doc-content .doc-section.active { display: block; }
                .doc-nav-link.active { background: white !important; border-color: rgba(0,0,0,0.1) !important; color: black !important; font-weight: 500; }

                #doc-content .doc-extra-body h1,
                #doc-content .doc-extra-body h2,
                #doc-content .doc-extra-body h3,
                #doc-content .doc-extra-body h4 { font-weight: 600; color: rgb(0,0,0); margin: 1.5em 0 0.5em; line-height: 1.25; }
                #doc-content .doc-extra-body h1 { font-size: 1.5rem; }
                #doc-content .doc-extra-body h2 { font-size: 1.25rem; }
                #doc-content .doc-extra-body h3 { font-size: 1.125rem; }
                #doc-content .doc-extra-body p { font-size: 14px; color: rgba(0,0,0,0.6); line-height: 1.7; margin: 0 0 1em; }
                #doc-content .doc-extra-body ul,
                #doc-content .doc-extra-body ol { font-size: 14px; color: rgba(0,0,0,0.6); line-height: 1.7; margin: 0 0 1em; padding-left: 1.5em; }
                #doc-content .doc-extra-body ul { list-style: disc; }
                #doc-content .doc-extra-body ol { list-style: decimal; }
                #doc-content .doc-extra-body li { margin-bottom: 0.25em; }
                #doc-content .doc-extra-body a { color: rgb(200,90,70); text-decoration: none; }
                #doc-content .doc-extra-body a:hover { text-decoration: underline; }
                #doc-content .doc-extra-body code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; background: #f4f4f5; padding: 2px 6px; border-radius: 4px; color: black; }
                #doc-content .doc-extra-body pre { background: #1e1e1e; color: #d4d4d4; padding: 1.25rem; border-radius: 0.75rem; overflow-x: auto; font-size: 13px; line-height: 1.6; margin: 1em 0; }
                #doc-content .doc-extra-body pre code { background: transparent; padding: 0; color: inherit; }
                #doc-content .doc-extra-body strong { font-weight: 700; color: black; }
                #doc-content .doc-extra-body blockquote { border-left: 4px solid rgb(200,90,70); padding-left: 1rem; margin: 1em 0; color: rgba(0,0,0,0.7); font-style: italic; }
              </style>

              {page.otherElements.map((extra) => (
                <section id={extra.slug} data-doc-section={extra.slug} class="doc-section mb-20 scroll-mt-24">
                  <h2 class="text-3xl sm:text-4xl font-normal leading-[1.1] text-black tracking-tight mb-6">{extra.name}</h2>
                  {extra.inhalt ? (
                    <div class="doc-extra-body" set:html={renderRichText(extra.inhalt, page.assets)} />
                  ) : null}
                </section>
              ))}

              {page.endpoints.map((ep) => (
                <section id={ep.slug} data-doc-section={ep.slug} class="doc-section mb-16 scroll-mt-24 pb-16 border-b border-black/5 last:border-b-0">
                  <div class="flex flex-wrap items-center gap-3 mb-4">
                    {ep.type && (
                      <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md font-mono tracking-wider">{ep.type}</span>
                    )}
                    {ep.endpointUrl && (
                      <code class="text-[14px] font-mono text-black break-all">{ep.endpointUrl}</code>
                    )}
                  </div>
                  <h3 class="text-2xl font-normal text-black tracking-tight mb-3">{ep.title}</h3>
                  {ep.describtion && (
                    <p class="text-[14px] text-black/60 leading-relaxed mb-8">{ep.describtion}</p>
                  )}

                  {ep.queryParameters.length > 0 && (
                    <div class="mb-8">
                      <ul class="space-y-2">
                        {ep.queryParameters.map((q) => (
                          <li class="flex items-start gap-3 py-2.5 px-4 bg-[#f4f4f5] rounded-lg">
                            <span class="text-[13px] text-black/70 leading-relaxed">{q}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {ep.exampleResponseJson && (
                    <div>
                      <div class="rounded-xl bg-[#1e1e1e] overflow-hidden">
                        <div class="flex items-center px-5 py-3 bg-[#252526] border-b border-white/5">
                          <div class="flex space-x-1.5 mr-3">
                            <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
                          </div>
                          <span class="text-[11px] text-white/40 font-mono">response.json</span>
                        </div>
                        <pre class="p-5 text-[13px] text-gray-300 font-mono leading-relaxed overflow-x-auto whitespace-pre"><code>{ep.exampleResponseJson}</code></pre>
                      </div>
                    </div>
                  )}
                </section>
              ))}

            </div>
          </div>
        </section>

        <script define:vars={{ validIds: allSlugs, initialId: initialSlug }}>
          function showDocSection(id, updateHash) {
            const sections = document.querySelectorAll('.doc-section');
            const links = document.querySelectorAll('.doc-nav-link');
            sections.forEach((el) => {
              el.classList.toggle('active', el.dataset.docSection === id);
            });
            links.forEach((a) => {
              a.classList.toggle('active', a.dataset.docLink === id);
            });
            if (updateHash) history.replaceState(null, '', '#' + id);
          }

          function initDocNav() {
            const rawHash = location.hash ? location.hash.slice(1) : '';
            const hasExplicitHash = rawHash && validIds.includes(rawHash);
            const id = hasExplicitHash ? rawHash : initialId;
            if (id) showDocSection(id, hasExplicitHash);

            if (!hasExplicitHash) {
              window.scrollTo(0, 0);
            }

            document.querySelectorAll('.doc-nav-link').forEach((a) => {
              a.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = a.dataset.docLink;
                if (targetId) showDocSection(targetId, true);
              });
            });

            window.addEventListener('hashchange', () => {
              const h = location.hash ? location.hash.slice(1) : '';
              if (validIds.includes(h)) showDocSection(h, true);
            });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initDocNav);
          } else {
            initDocNav();
          }
        </script>
      </>
    )}

  </main>
  <Footer />
</BaseLayout>
