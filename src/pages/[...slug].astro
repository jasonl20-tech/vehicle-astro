---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { renderRichText } from '../lib/contentful-rich-text';
import { loadLandingPages, type LandingPage, type AssetMap } from '../lib/cms-d1-content';
import { locales, defaultLocale, localizeUrl, type Locale } from '../i18n/utils';

export async function getStaticPaths() {
  const paths: Array<{ params: { slug: string }; props: { entry: LandingPage; assets: AssetMap; locale: Locale } }> = [];

  for (const locale of locales) {
    const cfLocale = locale === 'es' ? 'es' : 'en-US';
    const prefix = locale === defaultLocale ? '' : `${locale}/`;
    try {
      const res = await loadLandingPages({ locale: cfLocale, limit: 500 });
      for (const item of res.items) {
        paths.push({
          params: { slug: `${prefix}${item.slug}` },
          props: { entry: item, assets: res.assets, locale },
        });
      }
    } catch (e) {
      console.warn(`[[...slug]] D1 load failed for ${cfLocale}:`, e);
    }
  }

  return paths;
}

const { entry, assets, locale = 'en' as Locale } = Astro.props;

const title = entry?.title ?? 'Page';
const slug = entry?.slug ?? '';
const bodyHtml = entry?.body ? renderRichText(entry.body, assets) : '';
const pageTitle = entry?.metaTitle || `${title} | Vehicle Imagery`;
const pageDescription = entry?.metaDescription || title;
const canonical = localizeUrl(`/${slug}`, locale);
const siteUrl = Astro.url.origin;

const ogImage = entry?.ogImageUrl
  ? (entry.ogImageUrl.startsWith('http') ? entry.ogImageUrl : `${siteUrl}${entry.ogImageUrl.startsWith('/') ? '' : '/'}${entry.ogImageUrl}`)
  : undefined;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: pageDescription,
  url: `${siteUrl}${canonical}`,
});
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonical} ogImage={ogImage}>
  <Header />
  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    <section class="mx-auto max-w-3xl px-6 sm:px-12 lg:px-16 pt-20 pb-12">
      <header class="mb-12">
        {entry?.categoryName && (
          <p class="text-[10px] font-bold uppercase tracking-[0.25em] text-[rgb(200,90,70)] mb-6">{entry.categoryName}</p>
        )}
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-light leading-[0.95] text-black tracking-tight">{title}</h1>
      </header>

      {bodyHtml ? (
        <article class="blog-prose blog-article-body" set:html={bodyHtml} />
      ) : (
        <p class="text-black/60">No content.</p>
      )}
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={jsonLd} />
</BaseLayout>
