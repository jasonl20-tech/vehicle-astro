---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout1 from '../components/landing-layouts/Layout1.astro';
import Layout2 from '../components/landing-layouts/Layout2.astro';
import Layout3 from '../components/landing-layouts/Layout3.astro';
import Layout4 from '../components/landing-layouts/Layout4.astro';
import Layout5 from '../components/landing-layouts/Layout5.astro';
import { renderRichText } from '../lib/rich-text';
import { loadLandingPages, type LandingPage, type AssetMap } from '../lib/cms-d1-content';
import { locales, defaultLocale, localizeUrl, type Locale } from '../i18n/utils';

export async function getStaticPaths() {
  const paths: Array<{ params: { slug: string }; props: { entry: LandingPage; assets: AssetMap; locale: Locale } }> = [];

  for (const locale of locales) {
    const cfLocale = locale === 'es' ? 'es' : 'en-US';
    const prefix = locale === defaultLocale ? '' : `${locale}/`;
    try {
      const res = await loadLandingPages({ locale: cfLocale, limit: 500 });
      for (const item of res.items) {
        paths.push({
          params: { slug: `${prefix}${item.slug}` },
          props: { entry: item, assets: res.assets, locale },
        });
      }
    } catch (e) {
      console.warn(`[[...slug]] D1 load failed for ${cfLocale}:`, e);
    }
  }

  return paths;
}

const { entry, assets, locale = 'en' as Locale } = Astro.props;

const title = entry?.title ?? 'Page';
const slug = entry?.slug ?? '';
const bodyHtml = entry?.body ? renderRichText(entry.body, assets) : '';
const pageTitle = entry?.metaTitle || title;
const pageDescription = entry?.metaDescription || '';
const canonical = localizeUrl(`/${slug}`, locale);
const siteUrl = Astro.url.origin;
const pageUrl = `${siteUrl}${canonical}`;

const ogImage = entry?.ogImageUrl
  ? (entry.ogImageUrl.startsWith('http') ? entry.ogImageUrl : `${siteUrl}${entry.ogImageUrl.startsWith('/') ? '' : '/'}${entry.ogImageUrl}`)
  : undefined;

const updatedAtIso = entry?.updatedAt ? new Date(entry.updatedAt).toISOString() : undefined;
const inLanguageTag = locale === 'es' ? 'es-ES' : 'en-US';

const webPageSchema: Record<string, unknown> = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
  inLanguage: inLanguageTag,
  isPartOf: { '@id': `${siteUrl}/#website` },
};
if (ogImage) webPageSchema.primaryImageOfPage = { '@type': 'ImageObject', url: ogImage };
if (updatedAtIso) webPageSchema.dateModified = updatedAtIso;

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
  ],
};

const structuredDataGraph: unknown[] = [webPageSchema, breadcrumbSchema];

const layoutNumber = entry?.layoutNumber ?? 1;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonical}
  ogImage={ogImage}
  structuredDataGraph={structuredDataGraph}
>
  <Header />
  <main class="min-h-screen">
    {layoutNumber === 2 ? (
      <Layout2 title={title} bodyHtml={bodyHtml} />
    ) : layoutNumber === 3 ? (
      <Layout3 title={title} bodyHtml={bodyHtml} />
    ) : layoutNumber === 4 ? (
      <Layout4 title={title} bodyHtml={bodyHtml} />
    ) : layoutNumber === 5 ? (
      <Layout5 title={title} bodyHtml={bodyHtml} />
    ) : (
      <Layout1 title={title} bodyHtml={bodyHtml} />
    )}
  </main>
  <Footer />
</BaseLayout>
