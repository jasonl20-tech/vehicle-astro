---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CmsContactPageLayout from '../components/CmsContactPageLayout.astro';
import { loadContactPage, type AssetMap } from '../lib/cms-d1-content';
import { renderRichText } from '../lib/rich-text';
import { getLocaleFromUrl } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const cfLocale = locale === 'es' ? 'es' : 'en-US';

const { page, assets } = await loadContactPage('contact', { locale: cfLocale }).catch(() => ({
  page: null,
  assets: {} as AssetMap,
}));

const topHtml = page?.topText ? renderRichText(page.topText, assets) : '';
const bottomHtml = page?.bottomText ? renderRichText(page.bottomText, assets) : '';
---

{
  page ? (
    <CmsContactPageLayout
      metaTitle={page.metaTitle}
      metaDescription={page.metaDescription}
      canonicalUrl="/contact"
      topHtml={topHtml}
      bottomHtml={bottomHtml}
    />
  ) : (
    <BaseLayout title="Contact" description="" canonicalUrl="/contact">
      <Header />
      <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
        <section class="mx-auto max-w-3xl px-6 py-32 text-center">
          <h1 class="text-3xl font-light text-black mb-4">Contact</h1>
          <p class="text-black/60">No contact page content configured (D1: <code class="font-mono">contactPages</code>, Feld <code class="font-mono">which</code> mit z. B. &quot;Contact&quot;, &quot;Contact Form&quot; oder &quot;contactform&quot;).</p>
        </section>
      </main>
      <Footer />
    </BaseLayout>
  )
}
