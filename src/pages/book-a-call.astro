---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadFirmenKonfiguration } from '../lib/cms-d1-content';
import { getLocaleFromUrl } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const cfLocale = locale === 'es' ? 'es' : 'en-US';

const firma = await loadFirmenKonfiguration({ locale: cfLocale }).catch(() => null);
const meetingEmbed = firma?.meetingEmbed?.trim() || '';
---

<BaseLayout
  title="Book a Call"
  description=""
  canonicalUrl="/book-a-call"
>
  <Header />
  <main class="min-h-screen bg-white" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    <section class="mx-auto max-w-[1400px] px-6 pt-16 pb-24 sm:px-12 lg:px-16">
      {meetingEmbed ? (
        <div class="rounded-[2rem] overflow-hidden border border-black/[0.06] bg-white min-w-0 relative" style="min-height: 950px;">
          <Fragment set:html={meetingEmbed} />
        </div>
      ) : null}
    </section>
  </main>
  <Footer />
</BaseLayout>
