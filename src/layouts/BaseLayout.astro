---
import '../styles/global.css';
import { getLocaleFromUrl, getAlternateUrls, getOgLocale, type Locale } from '../i18n/utils';
import { loadFirmenKonfiguration } from '../lib/cms-d1-content';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  canonicalUrl?: string;
  noIndex?: boolean;
  keywords?: string;
  structuredDataGraph?: unknown[];
  preloadHero?: boolean;
  preloadFirstImage?: string;
}

const FALLBACK_BRAND = 'Vehicle Imagery';
const FALLBACK_SITE_NAME = 'Vehicle Imagery API';
const FALLBACK_OG_IMAGE = '/images/hero-car.webp';
const FALLBACK_OG_IMAGE_ALT = 'Vehicle Imagery';

const { title, description = '', ogImage, ogImageAlt, ogImageWidth: ogImageWidthProp, ogImageHeight: ogImageHeightProp, canonicalUrl, noIndex = false, keywords, structuredDataGraph, preloadHero = false, preloadFirstImage } = Astro.props;
const locale: Locale = getLocaleFromUrl(Astro.url);
const siteUrl = Astro.url.origin;
const cfLocale = locale === 'es' ? 'es' : 'en-US';

// Cached at module level - one D1 hit per locale per build run.
const firma = await loadFirmenKonfiguration({ locale: cfLocale }).catch(() => null);

const brandName = firma?.firmenName || FALLBACK_BRAND;
const siteName = firma?.siteName || FALLBACK_SITE_NAME;
const brandSuffix = ` | ${brandName}`;

const defaultOgImage = firma?.defaultOgImageUrl
  ? (firma.defaultOgImageUrl.startsWith('http') ? firma.defaultOgImageUrl : `${siteUrl}${firma.defaultOgImageUrl}`)
  : `${siteUrl}${FALLBACK_OG_IMAGE}`;
const defaultOgImageAlt = firma?.defaultOgImageAlt || FALLBACK_OG_IMAGE_ALT;
const defaultOgImageWidth = firma?.defaultOgImageWidth ?? 1200;
const defaultOgImageHeight = firma?.defaultOgImageHeight ?? 630;

const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`)
  : defaultOgImage;
const resolvedOgImageAlt = ogImageAlt || defaultOgImageAlt;
const ogUrl = canonicalUrl ? `${siteUrl}${canonicalUrl.startsWith('/') ? '' : '/'}${canonicalUrl}` : Astro.url.href;
const ogImageWidth = ogImageWidthProp ?? defaultOgImageWidth;
const ogImageHeight = ogImageHeightProp ?? defaultOgImageHeight;

const resolvedKeywords = keywords ?? firma?.keywords ?? '';

const alternateUrls = getAlternateUrls(Astro.url.pathname, siteUrl);

// Append brand suffix when the title doesn't already mention the brand
// and there's still room (Google truncates around 60 chars).
const needsBrand = !title.toLowerCase().includes(brandName.toLowerCase());
const finalTitle = (needsBrand && (title.length + brandSuffix.length) <= 70)
  ? `${title}${brandSuffix}`
  : title;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" type="image/png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {resolvedKeywords && <meta name="keywords" content={resolvedKeywords} />}
    {noIndex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow" />}
    <meta name="generator" content={Astro.generator} />
    <title>{finalTitle}</title>
    {canonicalUrl && <link rel="canonical" href={`${siteUrl}${canonicalUrl.startsWith('/') ? '' : '/'}${canonicalUrl}`} />}
    {alternateUrls.map(({ locale: loc, href }) => (
      <link rel="alternate" hreflang={loc} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrls.find(a => a.locale === 'en')?.href ?? siteUrl} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={getOgLocale(locale)} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    <meta name="twitter:image:width" content={ogImageWidth} />
    <meta name="twitter:image:height" content={ogImageHeight} />
    {preloadHero && <link rel="preload" as="image" href="/images/hero-car.webp" media="(min-width: 768px)" />}
    {preloadFirstImage && <link rel="preload" as="image" href={preloadFirstImage} media="(max-width: 767px)" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${siteUrl}/#organization`,
          name: brandName,
          url: siteUrl,
          logo: {
            '@type': 'ImageObject',
            url: firma?.logoUrl || `${siteUrl}/logo.svg`,
          },
        },
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          url: siteUrl,
          name: siteName,
          publisher: { '@id': `${siteUrl}/#organization` },
        },
        ...(structuredDataGraph ?? []),
      ],
    })} />
  </head>
  <body class="antialiased min-h-screen bg-cream text-gray-900">
    <slot />
    <script>
      document.addEventListener('contextmenu', (e) => {
        if (e.target && e.target.tagName === 'IMG') e.preventDefault();
      });
    </script>
  </body>
</html>
