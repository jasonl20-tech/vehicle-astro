# Site URL für Sitemap & SEO (z.B. https://vehicleimagery.com oder https://vehicle-astro.pages.dev)
SITE_URL=https://vehicleimagery.com

# Cloudflare D1 (für Build-Zeit-Abruf aller CMS-Inhalte)
# Account- und Database-ID stehen im Cloudflare Dashboard, Token mit "D1: Read" Permission anlegen.
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_API_TOKEN=your_d1_read_token

# Vehicle Imagery API (für Interior-Bilder: npm run download-interior)
# Kostenloser Key: https://vehicleimagery.com/contact
VEHICLEIMAGERY_API_KEY=your_api_key
